# ===========================================
# VARIÁVEIS OBRIGATÓRIAS PARA O SISTEMA DE RH
# ===========================================

# 1. Autenticação NextAuth (OBRIGATÓRIO)
# Gere com: openssl rand -base64 32
AUTH_SECRET=seu-auth-secret-aqui

# 2. URL da aplicação
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Banco de dados (escolha UMA opção)
#
# Opção A: DESENVOLVIMENTO (Recomendado) - Neon dev
# DATABASE_URL="postgresql://[user]:[pass]@ep-[ID].us-east-1.aws.neon.tech/sistemado_rh-db?schema=rh"
#
# Opção B: DESENVOLVIMENTO (Local) - Docker PostgreSQL
# docker run --name sistemadorh-pg -e POSTGRES_PASSWORD=password -p 5432:5432 -d postgres:15
# DATABASE_URL="postgresql://postgres:password@localhost:5432/sistemadorh?schema=rh"
#
# Opção C: TESTES/BUILD - SQLite (não funciona para npm run dev)
# DATABASE_URL="file:./prisma/dev.db"
#
# Opção D: PRODUÇÃO - Neon SOFTrh (configure na Vercel)
# DATABASE_URL="postgresql://[user]:[pass]@ep-solitary-lake-acrk7t0f.sa-east-1.aws.neon.tech/SOFTrh?schema=rh"
#
# === USE ESTA LINHA PARA COMEÇAR ===
DATABASE_URL="postgresql://postgres:password@localhost:5432/sistemadorh?schema=rh"

# ===========================================
# VARIÁVEIS OPCIONAIS
# ===========================================

# Cron jobs (protege endpoints de cron)
# CRON_SECRET=seu-cron-secret-aqui

# Integração Telegram (opcional)
# TELEGRAM_BOT_TOKEN=seu-token-do-bot

# E-mail (obrigatório para convites e recuperação de senha)
# Pode ser configurado também em Administração → Canais de envio.
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_USER=seu-email
# SMTP_PASS=sua-senha-de-app
# EMAIL_FROM="Sistema de RH <noreply@seudominio.com>"

# Anthropic API (para assistente de RH - opcional)
# ANTHROPIC_API_KEY=sk-ant-...

# Blob storage (opcional)
# BLOB_READ_WRITE_TOKEN=seu-token
