// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Este app usa APENAS o schema `rh` — inclusive o User. Até 25/07/2026 a
  // autenticação era a tabela `shared.User`, dividida com o lm-bonificacao;
  // hoje cada app tem a sua, e não existe mais nenhuma referência do RH a
  // objeto de outro schema. Desde 01/08/2026 o banco (`SOFTrh`) também é um
  // projeto Neon dedicado — os schemas `bonificacao`, `shared` e `vapt` não
  // existem mais aqui, moram no Neon dos outros apps (ver README, "Notas
  // sobre o banco").
  schemas  = ["rh"]
}

// Enums are kept as plain String columns (not Prisma `enum`) so the schema
// works unchanged on both SQLite (local dev) and Postgres (production),
// since SQLite does not support native enums.
// Role: "ADMIN" | "DIRETORIA" | "RH_MANAGER" | "GESTOR_SETOR"
// StatusPesquisa: "DRAFT" | "ACTIVE" | "FINISHED" | "ARCHIVED"
// TipoPergunta: "LIKERT_5" | "FREQ_0_4" | "NPS_10" | "MULTIPLE_CHOICE" | "TEXT" (ver lib/constants-rh.ts)
// DimensaoGPTW: "CREDIBILIDADE" | "RESPEITO" | "IMPARCIALIDADE" | "ORGULHO" | "CAMARADAGEM" | "GERAL"
// CanalToken: não é um domínio único — cada model que reaproveita a coluna `canal`
//   tem seu próprio conjunto: SurveyToken usa "TELEGRAM" | "EMAIL", PortalAcesso usa
//   "TELEGRAM" | "RH", Reconhecimento só grava "TELEGRAM" hoje.
// StatusToken: "PENDING" | "SENT" | "DELIVERED" | "FAILED" | "RESPONDED" | "EXCLUIDO" (ver lib/constants-rh.ts)
// TipoDocumento / TipoAusencia / TipoContrato: ver lib/constants-dp.ts
// StatusSolicitacao: "PENDENTE" | "APROVADA" | "REPROVADA" | "CANCELADA"

// Usuários do sistema (RH, diretoria, gestores). Vive no schema `rh` desde
// 25/07/2026: antes era `shared.User`, a mesma tabela do lm-bonificacao, e as
// duas aplicações dividiam login. A partir do desacoplamento cada app tem a sua
// tabela — o cadastro nasceu de uma cópia, mas evolui separado (criar usuário
// ou trocar senha aqui não muda nada no lm-bonificacao, e vice-versa).
model User {
  id                        String    @id @default(cuid())
  nome                      String
  username                  String    @unique
  passwordHash              String
  role                      String
  ativo                     Boolean   @default(true)
  email                     String?   @unique
  telefone                  String?
  avatarUrl                 String?
  // Definidos quando o usuário é criado via convite e ainda não aceitou:
  // `conviteExpiraEm` bloqueia o `aceitarConviteUsuario` se passou do prazo,
  // e `conviteTokenHash` guarda só o hash SHA-256 do token — o valor em claro
  // só volta na URL uma vez, no e-mail.
  conviteExpiraEm           DateTime?
  conviteTokenHash          String?
  // "Esqueci minha senha" — mesmo padrão do convite: só o hash do token fica
  // no banco, o valor em claro vai uma vez só no e-mail. Um token ativo por
  // vez (pedir de novo invalida o anterior).
  recuperacaoSenhaExpiraEm  DateTime?
  recuperacaoSenhaTokenHash String?
  ultimoAcessoEm            DateTime?
  createdAt                 DateTime  @default(now())

  // Escopo do módulo de RH: preenchido apenas para RH_MANAGER (empresaId) e
  // GESTOR_SETOR (empresaId + setorId). ADMIN/DIRETORIA ficam nulos.
  // Colunas legadas mantidas durante a transição para o pivô UserEmpresa —
  // remoção fica para a Fase 8 do plano multi-empresa.
  empresaId String?
  setorId   String?

  // Qual pessoa da folha é este login. Até 12/08/2026 não existia resposta:
  // `User` e `Colaborador` eram dois cadastros sem ponte, então um gestor que
  // entrava pelo sistema não tinha como o servidor saber quem ele é — e
  // portanto não dava para mostrar "meu time" (que sai de
  // `Colaborador.supervisorId`) em nenhuma tela com login.
  //
  // OPCIONAL de propósito, e assim fica: ADMIN e o pessoal do RH costumam não
  // ter ficha na empresa que administram, e exigir vínculo os trancaria para
  // fora. Só quem precisa ver o próprio time precisa disto preenchido.
  //
  // @unique porque é 1:1 — duas contas apontando para a mesma ficha fariam
  // "meu time" responder coisas diferentes conforme o login usado.
  // onDelete: SetNull — desligar alguém não pode apagar o login (que carrega
  // auditoria); o vínculo cai e o acesso vira decisão explícita do RH.
  colaboradorId String?      @unique
  colaborador   Colaborador? @relation("LoginDoColaborador", fields: [colaboradorId], references: [id], onDelete: SetNull)

  // Pivô: lista de empresas onde este usuário tem papel. ADMIN/DIRETORIA
  // permanecem com este array vazio (papel é global). RH_MANAGER e
  // GESTOR_SETOR têm 1+ linhas, com exatamente uma marcada papelPrincipal.
  empresas         UserEmpresa[]
  // Acesso concedido por marca inteira — ver o model UserMarca.
  marcas           UserMarca[]
  pesquisasCriadas Pesquisa[]
  // Controle de acesso fino (Onda 1): perfis atribuídos a este usuário.
  perfis           UserPerfil[]

  // Módulo Delegações: as pessoas que este login marcou como favoritas para
  // delegar, e as listas em que ele aparece como favorito de alguém.
  favoritosDelegacao   DelegacaoFavorito[] @relation("FavoritosDeDelegacao")
  favoritadoPorDelegacao DelegacaoFavorito[] @relation("FavoritadoParaDelegacao")

  // Módulo Delegações: demandas em que este login é quem pediu / quem faz.
  // FK de verdade (não snapshot): o motor de cobrança PRECISA de um dono vivo
  // para cobrar — e usuário aqui é desativado (`ativo=false`), nunca apagado.
  demandasSolicitadas Demanda[] @relation("DemandaSolicitante")
  demandasRecebidas   Demanda[] @relation("DemandaResponsavel")
  reunioesMarcadas    Reuniao[] @relation("ReuniaoSolicitante")

  @@index([empresaId])
  @@index([setorId])
  @@schema("rh")
}

// Pivô usuário × empresa: define em quais empresas um usuário tem papel de
// RH e qual papel (RH_MANAGER ou GESTOR_SETOR) ele exerce em cada uma.
// ADMIN e DIRETORIA ficam fora — eles têm perfil global, sem empresa.
//
// `papelPrincipal` indica a empresa que abre por padrão após o login
// (enquanto o cookie `rh_empresa_ativa` não disser outra coisa). Apenas uma
// linha por usuário pode ter papelPrincipal=true — a action de vincular
// rebaixa a anterior antes de marcar a nova.
//
// Desativar a empresa NÃO derruba a linha: `UserEmpresa.ativo` é que vira
// false. A linha continua viva para preservar histórico de auditoria
// (logs guardam snapshot, não FK).
model UserEmpresa {
  id             String   @id @default(cuid())
  userId         String
  empresaId      String
  role           String // "RH_MANAGER" | "GESTOR_SETOR"
  setorId        String?
  ativo          Boolean  @default(true)
  papelPrincipal Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id])
  setor   Setor?  @relation(fields: [setorId], references: [id], onDelete: SetNull)

  @@unique([userId, empresaId])
  @@index([empresaId])
  @@index([userId])
  @@schema("rh")
}

// ------------------------------------------------------
// MÓDULO DE RH — ESTRUTURA DO GRUPO (marca → CNPJ)
// ------------------------------------------------------
// Duas camadas, e a distinção importa:
//
//   Marca   — como o grupo se apresenta (LM Telecom, Centrysol, VAPT).
//             É o nível que a diretoria enxerga e onde os números somam.
//   Empresa — a pessoa jurídica, o CNPJ. É de onde a folha sai e a quem a
//             obrigação acessória é cobrada. Uma marca pode ter vários.
//
// `Empresa` continua sendo o dono de Setor/Posicao/Colaborador/Pesquisa e de
// todos os demais registros — 33 tabelas apontam para `empresaId`, e nenhuma
// precisou mudar quando a Marca entrou acima. O colaborador se vincula ao
// CNPJ porque é esse o vínculo empregatício, não à marca.

model Marca {
  id          String   @id @default(cuid())
  nome        String   @unique
  logoUrl     String?
  // Hex "#RRGGBB", validado na action antes de gravar. Aplicado como override
  // da variável CSS --primary no layout da empresa (server component) — só
  // nesse subtree, não muda o tema global nem outras marcas. null = usa o
  // azul padrão do tema.
  corPrimaria String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  empresas  Empresa[]
  pesquisas Pesquisa[]
  usuarios  UserMarca[]
  // Módulo Delegações: demandas etiquetadas com esta marca (decisão da
  // Direção em 28/08/2026 — FK para o cadastro vivo, não texto livre).
  demandas  Demanda[]

  @@schema("rh")
}

// Acesso concedido a uma MARCA inteira, em vez de CNPJ a CNPJ. O vínculo é
// dinâmico de propósito: CNPJ novo cadastrado na marca entra no acesso sozinho,
// que é o que "dê acesso à marca" significa para quem usa. Por isso mora numa
// tabela própria e não como coluna opcional em UserEmpresa — ali empresaId é
// obrigatório e a unicidade é (userId, empresaId), que não acomoda "a marca
// toda" sem virar linha fantasma.
//
// A expansão marca -> empresas acontece no servidor a cada request
// (empresasVisiveis, em lib/rh-auth-guard.ts), nunca no JWT: gravada no token,
// a lista congelaria até o próximo login.
model UserMarca {
  id        String   @id @default(cuid())
  userId    String
  marcaId   String
  role      String // "RH_MANAGER" | "GESTOR_SETOR"
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  marca Marca @relation(fields: [marcaId], references: [id])

  @@unique([userId, marcaId])
  @@index([userId])
  @@index([marcaId])
  @@schema("rh")
}

model Empresa {
  id        String   @id @default(cuid())
  // Nome curto de exibição — o que aparece no seletor e nos títulos. Continua
  // sendo o rótulo do dia a dia; razão social é para documento.
  nome      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  // --- Identificação da pessoa jurídica (Fase 6) ---
  // Opcionais porque as empresas já existentes foram criadas antes desta
  // fase e o dado ainda não foi levantado. A tela cobra o preenchimento; o
  // banco não bloqueia, para não travar o que já está em uso.
  marcaId           String
  razaoSocial       String?
  nomeFantasia      String?
  // Guardado só com dígitos (14), sem máscara — a formatação é da tela.
  cnpj              String? @unique
  inscricaoEstadual String?
  cidade            String?
  uf                String?

  marca                    Marca                     @relation(fields: [marcaId], references: [id])
  setores                  Setor[]
  posicoes                 Posicao[]
  colaboradores            Colaborador[]
  pesquisas                Pesquisa[]
  userEmpresas             UserEmpresa[]
  planosAcao               PlanoAcao[]
  tiposBeneficio           TipoBeneficio[]
  catalogoItens            CatalogoItem[]
  ocorrenciasDisciplinares OcorrenciaDisciplinar[]
  configuracaoPonto        ConfiguracaoPontoEmpresa?

  @@index([marcaId])
  @@schema("rh")
}

// Catálogo genérico ADITIVO — mesmo raciocínio de TipoBeneficio, mas cobrindo
// de uma vez os 9 catálogos fixos que o levantamento de 04/08/2026 confirmou
// serem SÓ RÓTULO (nenhum código compara valor exato pra decidir
// comportamento): dimensão GPTW, tipo de turno, competência, status de meta,
// origem de candidato, tipo de acidente, tipo de EPI, motivo de entrega de
// EPI, tipo de movimentação. `categoria` é o discriminador — ver
// lib/catalogos.ts pra lista completa e os catálogos fixos de cada uma.
//
// Os DEMAIS catálogos fixos do sistema (status de pesquisa, tipo de
// documento, etapa de funil, ...) FICAM DE FORA de propósito: têm código que
// compara contra o value exato pra decidir fluxo (ex.: "CONTRATADO" cria
// colaborador, "ADMISSIONAL" muda regra de vencimento) — deixar o RH
// cadastrar um valor novo ali quebraria esse fluxo, porque nenhum código
// saberia lidar com o valor desconhecido.
//
// `cor` e `validadeMeses` são opcionais e usados só por TIPO_TURNO e
// TIPO_EPI respectivamente — os outros 7 catálogos deixam null.
model CatalogoItem {
  id            String   @id @default(cuid())
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id])
  categoria     String
  nome          String
  cor           String?
  validadeMeses Int?
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@unique([empresaId, categoria, nome])
  @@index([empresaId, categoria])
  @@schema("rh")
}

// Catálogo de benefícios ADITIVO: lib/constants-beneficios.ts continua tendo
// os 11 tipos fixos que sempre existiram (VALE_TRANSPORTE, PLANO_SAUDE, ...) —
// nenhum BeneficioColaborador antigo muda de significado. Esta tabela só
// ACRESCENTA opções por empresa, pro RH cadastrar o que o catálogo fixo não
// cobre (ex.: "Auxílio-home-office", específico de uma empresa) sem esperar
// deploy. `BeneficioColaborador.tipo` continua String livre — aceita tanto um
// value do catálogo fixo quanto o nome de uma linha daqui.
model TipoBeneficio {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@schema("rh")
}

model Setor {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  colaboradores Colaborador[]
  metas         Meta[]
  vagas         Vaga[]
  userEmpresas  UserEmpresa[]
  planosAcao    PlanoAcao[]

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@schema("rh")
}

model Posicao {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  colaboradores Colaborador[]
  requisitosNR  RequisitoNR[]
  vagas         Vaga[]

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@schema("rh")
}

model Colaborador {
  id                  String        @id @default(cuid())
  empresaId           String
  empresa             Empresa       @relation(fields: [empresaId], references: [id])
  nome                String
  cpf                 String?
  email               String?
  // Telefone/celular de contato (formato livre, como veio do elleven) — usado
  // pelo RH para contato e envio de convites de pesquisa (WhatsApp/Telegram).
  telefone            String?
  // "Masculino" | "Feminino" | outro texto livre (importado do elleven) —
  // usado apenas em agregados demográficos das pesquisas (snapshot na Resposta).
  sexo                String?
  cidade              String?
  dataNascimento      DateTime?
  // "Cod Pessoa" do cadastro no elleven (ERP) — chave para re-sincronizar sem
  // depender de CPF preenchido.
  ellevenCodigo       String?
  // Razão social do CNPJ que assina a carteira. A planilha do DP traz 11 delas
  // para 3 marcas — guardar aqui evita multiplicar Empresa, que 33 tabelas
  // referenciam por empresaId.
  razaoSocial         String?
  setorId             String
  setor               Setor         @relation(fields: [setorId], references: [id])
  posicaoId           String
  posicao             Posicao       @relation(fields: [posicaoId], references: [id])
  // A quem reporta — base do organograma. Sem @relation nomeada explícita não
  // dá porque é auto-relacionamento; onDelete SetNull: se o supervisor sai, o
  // time não é apagado, só fica temporariamente sem líder até o RH realocar.
  supervisorId        String?
  supervisor          Colaborador?  @relation("SupervisorDoColaborador", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinados        Colaborador[] @relation("SupervisorDoColaborador")
  // Avisos automáticos: os que ESTA pessoa recebeu como gestor, e os que foram
  // enviados SOBRE ela. Duas relações porque AvisoGestor liga dois
  // colaboradores — quem lidera e quem é o assunto.
  avisosComoGestor    AvisoGestor[] @relation("AvisosRecebidosComoGestor")
  avisosSobreMim      AvisoGestor[] @relation("AvisosSobreMim")
  // Veículos da frota em que esta pessoa é o motorista vinculado.
  veiculosQueDirige   Veiculo[]     @relation("MotoristaDoVeiculo")
  // O login desta pessoa no sistema, quando existe — ver User.colaboradorId.
  // A maioria das fichas não tem: colaborador de chão de fábrica entra pelo
  // portal, pelo Telegram, sem usuário e sem senha.
  usuario             User?         @relation("LoginDoColaborador")
  // Quem avalia a equipe no ciclo de desempenho. É outra pergunta que a de
  // cima: `supervisorId` diz a quem a pessoa reporta; aqui quem avalia é o
  // gerente, que pode ter muito mais gente do que o organograma mostra — e em
  // parte das empresas o organograma nem existe. Marcado pelo RH; o gerente
  // monta a própria lista de avaliados pelo portal.
  gerente             Boolean       @default(false)
  // Chat ID numérico do Telegram do colaborador, obtido manualmente (RH pede
  // pro colaborador dar /start no bot e lê o chat_id via Bot API getUpdates).
  // Sem isso, o convite da pesquisa não pode ser enviado automaticamente.
  telegramChatId      String?
  // Foto de referência: o rosto contra o qual o RH compara a selfie de cada
  // batida de ponto. Sem ela a conferência humana não fecha — quem abre a foto
  // de uma batida não tem com o que comparar, e ninguém reconhece 170 pessoas
  // de memória. Decidido em 13/08/2026, junto com a escolha de NÃO contratar
  // comparação automática de rosto (ver lib/atualizacoes.ts v1.83.2).
  //
  // Guarda a URL do Blob privado, como `RegistroPonto.fotoUrl` — nunca o
  // conteúdo. Servida só por rota autenticada, que audita quem viu.
  fotoUrl             String?
  // Se a foto de referência foi posta ou confirmada por uma pessoa do RH.
  //
  // `false` = veio da promoção automática da primeira selfie de batida (o
  // sistema não tinha nada e adotou a primeira que chegou). É útil e imediato,
  // mas carrega um risco lógico: se ESSA primeira batida tiver sido feita por
  // outra pessoa, a referência nasce errada e passa a validar a fraude. Por
  // isso o painel marca a referência não conferida, e conferir é um clique.
  fotoConferidaPeloRh Boolean       @default(false)
  ativo               Boolean       @default(true)
  // Se este colaborador pode bater ponto pelo portal. Nasce BLOQUEADO — a
  // liberação é manual, pessoa por pessoa, na aba "Colaboradores" de Ponto
  // Eletrônico. Antes deste campo, todo colaborador ativo batia ponto sem
  // nenhum controle individual.
  pontoLiberado       Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // ---- Ficha completa (Core HR) ----
  // Tudo opcional: a base veio do elleven só com nome/CPF/contato e vai sendo
  // completada pelo RH aos poucos. Nenhum campo aqui pode quebrar a importação.
  matricula      String?
  rg             String?
  rgOrgaoEmissor String?
  rgUf           String?
  pis            String?
  ctpsNumero     String?
  ctpsSerie      String?
  ctpsUf         String?
  tituloEleitor  String?
  estadoCivil    String?
  escolaridade   String?
  nomeMae        String?
  nomePai        String?
  nacionalidade  String?
  naturalidade   String?

  // Endereço (a coluna `cidade` acima já existe, veio do elleven)
  cep            String?
  logradouro     String?
  numeroEndereco String?
  complemento    String?
  bairro         String?
  uf             String?

  // Contato de emergência — quem o RH aciona quando algo acontece em campo.
  emergenciaNome       String?
  emergenciaParentesco String?
  emergenciaTelefone   String?

  // Dados bancários (pagamento). Sensíveis: só ADMIN/RH_MANAGER enxergam.
  bancoNome      String?
  bancoAgencia   String?
  bancoConta     String?
  bancoTipoConta String?
  chavePix       String?

  // ---- Vínculo / contrato ----
  // dataAdmissao é a base do cálculo de períodos aquisitivos de férias
  // (lib/ferias.ts). Sem ela, o colaborador não entra no controle de férias.
  dataAdmissao               DateTime?
  dataDesligamento           DateTime?
  motivoDesligamento         String?
  // Desligamento anterior ao sistema, sem como cobrar devolução de crachá,
  // notebook, EPI — nem entrevista de saída — de quem já saiu há tempo. A
  // dispensa tira a pessoa das pendências de checklist E de entrevista
  // (desligamentos/page.tsx) e exige motivo + data preenchidos
  // (lib/actions/rh-offboarding.ts) — não é geração automática do checklist
  // com os 11 itens marcados como conferidos, que registraria uma devolução
  // que não aconteceu. Além do botão na ficha, corrigirDadosDesligamento
  // dispensa sozinho ao confirmar data+motivo de quem entrou no sistema já
  // desligado (dataDesligamento < createdAt) — regra do CEO em 07/08/2026.
  checklistDispensado        Boolean   @default(false)
  checklistDispensadoEm      DateTime?
  checklistDispensadoPorId   String?
  checklistDispensadoPorNome String?
  tipoContrato               String?
  // Fim do prazo, para os contratos que têm prazo (EXPERIENCIA, TEMPORARIO,
  // ESTAGIO — ver CONTRATOS_POR_PRAZO em lib/constants-dp.ts). Deixar vencer
  // sem ação transforma o contrato em indeterminado (CLT art. 445 e 451): é o
  // vencimento mais caro do RH e era o único que o sistema não enxergava.
  dataFimContrato            DateTime?
  jornadaSemanal             Int?
  salarioBase                Float?

  // Primeira entrada no portal do colaborador confirmada por CPF. O vínculo do
  // Telegram casa pelos últimos 8 dígitos do telefone importado do elleven —
  // margem de erro tolerável para convidar alguém a responder uma pesquisa,
  // inaceitável para abrir salário e documentos. Por isso o portal exige o CPF
  // uma vez, mesmo para quem já vinculou pelo telefone.
  portalVerificadoEm DateTime?

  // PIN do app de ponto (/ponto) — bcrypt, nunca o valor em claro. `null` =
  // sem PIN definido, login recusado. Quem define/reseta é o RH, na aba
  // "Colaboradores" de Ponto Eletrônico; o PIN em claro só existe no retorno
  // daquela action, uma vez (mesmo princípio do link do Telegram).
  pontoPinHash String?

  tokens    SurveyToken[]
  respostas Resposta[]

  dependentes              Dependente[]
  documentos               DocumentoColaborador[]
  ferias                   SolicitacaoFerias[]
  ausencias                Ausencia[]
  acessosPortal            PortalAcesso[]
  sessoesPortal            PortalSessao[]
  mensagensPortal          MensagemPortal[]
  certificados             CertificadoNR[]
  exames                   ExameOcupacional[]
  movimentacoes            Movimentacao[]            @relation("MovimentacaoDoColaborador")
  beneficios               BeneficioColaborador[]
  reconhecimentos          Reconhecimento[]
  entregasEpi              EntregaEPI[]
  entregas                 EntregaAoColaborador[]
  acidentes                AcidenteTrabalho[]
  escalas                  EscalaTurno[]
  eventosFolha             EventoFolha[]
  checklistIntegracao      ChecklistIntegracao[]
  checklistDesligamento    ChecklistDesligamento[]
  entrevistaDesligamento   EntrevistaDesligamento?
  avaliacoesRecebidas      AvaliacaoDesempenho[]
  metas                    Meta[]
  pdi                      PlanoDesenvolvimento[]
  participacoesTreinamento ParticipacaoTreinamento[]
  ocorrenciasDisciplinares OcorrenciaDisciplinar[]
  registrosPonto           RegistroPonto[]
  tratamentosPonto         TratamentoPonto[]
  bancosHoras              BancoHoras[]
  cobrancasCadastro        CobrancaCadastro[]
  sessoesPonto             PontoSessao[]
  // Módulo Processos & Ativos: quem dirige é o MESMO colaborador, com uma
  // extensão — não um cadastro paralelo de motorista para manter em dia.
  condutor                 Condutor?

  // Registros de ponto (entrada/saída)

  @@unique([empresaId, cpf])
  @@unique([telegramChatId])
  @@index([empresaId])
  @@index([setorId])
  @@index([posicaoId])
  @@index([empresaId, dataAdmissao])
  @@index([empresaId, dataFimContrato])
  @@index([supervisorId])
  @@index([empresaId, gerente])
  @@schema("rh")
}

// ------------------------------------------------------
// DEPARTAMENTO PESSOAL — FASE 1
// ------------------------------------------------------
// Referências a User (`*PorId`) são SOFT: guardam o id e um snapshot do nome,
// sem @relation. Em trilha de auditoria, o nome de quem agiu precisa sobreviver
// à exclusão do usuário — e o portal registra o próprio colaborador como ator,
// que nem usuário do sistema é.

model Dependente {
  id             String      @id @default(cuid())
  colaboradorId  String
  colaborador    Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  nome           String
  parentesco     String
  dataNascimento DateTime?
  cpf            String?
  // Para que o dependente conta — reflete direto em IRRF, salário-família e
  // custo do plano de saúde (usado no bloco de benefícios, Fase 2).
  irrf           Boolean     @default(false)
  salarioFamilia Boolean     @default(false)
  planoSaude     Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([colaboradorId])
  @@schema("rh")
}

// Conteúdo binário dos anexos (dossiê digital e atestados). Fica numa tabela
// própria, separada dos metadados, para que listagens NUNCA carreguem o blob
// por engano. Documento de RH é dado pessoal sensível: guardar no Postgres com
// download autenticado (rota /api/rh/.../arquivo) em vez de um blob público.
model Arquivo {
  id            String   @id @default(cuid())
  empresaId     String
  nome          String
  mimeType      String
  tamanhoBytes  Int
  // Dois modos de armazenamento convivem: `blobUrl` (Vercel Blob) é o caminho
  // novo, `conteudo` guarda o que já estava no banco. Com os documentos das
  // 253 pessoas, manter tudo em Bytes levaria o Postgres a poucos GB.
  blobUrl       String?
  conteudo      Bytes?
  criadoPorId   String?
  criadoPorNome String?
  createdAt     DateTime @default(now())

  documento               DocumentoColaborador?
  ausencia                Ausencia?
  certificado             CertificadoNR?
  exame                   ExameOcupacional?
  entregaEpi              EntregaEPI?
  acidente                AcidenteTrabalho?
  participacaoTreinamento ParticipacaoTreinamento?
  curriculo               Candidato?
  tratamentoPonto         TratamentoPonto?
  ocorrenciaDisciplinar   OcorrenciaDisciplinar?
  // Primeiro anexo do módulo Processos & Ativos (27/08/2026). Até aqui o
  // `Arquivo` só servia ao RH; `DocumentoVeiculo.arquivoId` existia como
  // coluna solta, sem relação — ninguém escrevia nela. Agora o CRLV, o
  // licenciamento e a apólice do carro moram na mesma esteira do dossiê do
  // colaborador: mesma validação, mesma auditoria de download.
  documentoVeiculo        DocumentoVeiculo?
  // Evidência de entrega do módulo Delegações (28/08/2026) — mesma esteira.
  demandaEntrega          DemandaEntrega?

  @@index([empresaId])
  @@schema("rh")
}

model DocumentoColaborador {
  id               String      @id @default(cuid())
  empresaId        String
  colaboradorId    String
  colaborador      Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  tipo             String
  descricao        String?
  emitidoEm        DateTime?
  // Quando preenchido, entra no painel de vencimentos (ASO, NRs, contratos).
  validoAte        DateTime?
  observacoes      String?
  arquivoId        String?     @unique
  arquivo          Arquivo?    @relation(fields: [arquivoId], references: [id], onDelete: SetNull)
  // "RH" | "COLABORADOR". O que vem do portal aguarda conferência antes de
  // valer como verdade cadastral — `conferidoEm` nulo = ainda na fila.
  origem           String      @default("RH")
  conferidoEm      DateTime?
  conferidoPorNome String?
  criadoPorId      String?
  criadoPorNome    String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([colaboradorId])
  @@index([empresaId, validoAte])
  @@index([empresaId, origem, conferidoEm])
  @@schema("rh")
}

// Férias em regime CLT. Os períodos aquisitivos NÃO são materializados: são
// derivados da data de admissão + solicitações aprovadas em lib/ferias.ts —
// assim não existe tabela para manter em dia por cron. O que se guarda aqui é
// o início do período aquisitivo a que a solicitação se refere, para o saldo
// não mudar retroativamente se a data de admissão for corrigida depois.
model SolicitacaoFerias {
  id                      String      @id @default(cuid())
  empresaId               String
  colaboradorId           String
  colaborador             Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  periodoAquisitivoInicio DateTime
  dataInicio              DateTime
  dataFim                 DateTime
  dias                    Int
  // Abono pecuniário: venda de até 1/3 (10 dias) do período — CLT art. 143.
  diasAbono               Int         @default(0)
  decimoAntecipado        Boolean     @default(false)
  observacoes             String?
  status                  String      @default("PENDENTE")
  solicitadoPorId         String?
  solicitadoPorNome       String?
  decididoPorId           String?
  decididoPorNome         String?
  decididoEm              DateTime?
  motivoDecisao           String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@index([empresaId, status])
  @@index([colaboradorId, status])
  @@index([empresaId, dataInicio])
  @@schema("rh")
}

model Ausencia {
  id                   String      @id @default(cuid())
  empresaId            String
  colaboradorId        String
  colaborador          Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  tipo                 String
  dataInicio           DateTime
  dataFim              DateTime
  dias                 Int
  // Abonada = não conta como falta no absenteísmo (atestado aceito, licença).
  abonada              Boolean     @default(false)
  cid                  String?
  profissional         String?
  registroProfissional String?
  observacoes          String?
  status               String      @default("PENDENTE")
  arquivoId            String?     @unique
  arquivo              Arquivo?    @relation(fields: [arquivoId], references: [id], onDelete: SetNull)
  registradoPorId      String?
  registradoPorNome    String?
  decididoPorId        String?
  decididoPorNome      String?
  decididoEm           DateTime?
  motivoDecisao        String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  // Back-relation opcional: quando esta ausência é o afastamento decorrente de
  // um acidente de trabalho registrado. Sem coluna aqui — o FK mora do lado do
  // AcidenteTrabalho.
  acidente AcidenteTrabalho?

  @@index([empresaId, status])
  @@index([colaboradorId, dataInicio])
  @@index([empresaId, dataInicio])
  @@schema("rh")
}

// Histórico de promoção, transferência de setor e mudança de líder — a base do
// organograma (Colaborador.supervisorId é a foto atual; isto aqui é o filme).
// Cada linha guarda o ANTES e o DEPOIS de cada campo que mudou nesse evento;
// campo null nos dois lados = não mudou nesse evento específico. Aplicar a
// movimentação atualiza Colaborador na mesma transação — o histórico nunca
// diverge do estado atual porque os dois nascem juntos.
model Movimentacao {
  id            String      @id @default(cuid())
  empresaId     String
  colaboradorId String
  colaborador   Colaborador @relation("MovimentacaoDoColaborador", fields: [colaboradorId], references: [id], onDelete: Cascade)
  // PROMOCAO | TRANSFERENCIA_SETOR | MUDANCA_SUPERVISOR | MUDANCA_CARGO | OUTRO
  tipo          String
  dataEfetiva   DateTime

  setorAnteriorNome      String?
  setorNovoId            String?
  setorNovoNome          String?
  posicaoAnteriorNome    String?
  posicaoNovaId          String?
  posicaoNovaNome        String?
  supervisorAnteriorNome String?
  supervisorNovoId       String?
  supervisorNovoNome     String?

  motivo            String?
  observacoes       String?
  registradoPorId   String?
  registradoPorNome String?
  createdAt         DateTime @default(now())

  @@index([empresaId, dataEfetiva])
  @@index([colaboradorId, dataEfetiva])
  @@schema("rh")
}

// Benefícios do colaborador (VT, VR/VA, plano de saúde, ...). "Ativo" não é
// coluna: é dataFim null OU no futuro — encerrar é preencher dataFim, não
// apagar a linha, porque o custo histórico (quanto a empresa pagou em cada
// mês) precisa continuar reconstituível depois que o benefício acabou.
// Cobertura de dependente já existe como flag em Dependente (irrf/
// salarioFamilia/planoSaude, da Fase 1) — não duplicado aqui.
model BeneficioColaborador {
  id               String      @id @default(cuid())
  empresaId        String
  colaboradorId    String
  colaborador      Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  tipo             String
  operadora        String?
  plano            String?
  // Custo para a empresa e desconto em folha do colaborador — normalmente
  // diferentes (a empresa costuma subsidiar parte do plano de saúde, por ex).
  valorEmpresa     Float?
  valorColaborador Float?
  dataInicio       DateTime
  dataFim          DateTime?
  observacoes      String?
  criadoPorId      String?
  criadoPorNome    String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([empresaId, tipo])
  @@index([colaboradorId, dataFim])
  @@schema("rh")
}

// Registro de parabéns enviados (aniversário / tempo de casa), pelo mesmo bot
// do Telegram que já manda convite de pesquisa. A unique de (colaborador,
// tipo, ano) é o que evita mandar "feliz aniversário" duas vezes no mesmo
// ano se alguém clicar duas vezes — sem precisar de trava em memória.
model Reconhecimento {
  id             String      @id @default(cuid())
  empresaId      String
  colaboradorId  String
  colaborador    Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  // ANIVERSARIO | TEMPO_CASA
  tipo           String
  // Ano-calendário do envio (não o ano do evento) — é a chave que impede
  // duplicidade dentro do mesmo ano.
  ano            Int
  anosCompletos  Int?
  canal          String      @default("TELEGRAM")
  enviadoPorId   String?
  enviadoPorNome String?
  createdAt      DateTime    @default(now())

  @@unique([colaboradorId, tipo, ano])
  @@index([empresaId, createdAt])
  @@schema("rh")
}

// ------------------------------------------------------
// SAÚDE, SEGURANÇA E CONFORMIDADE — FASE 2
// ------------------------------------------------------
// Numa operação de telecom com técnico em campo, o que pega numa fiscalização
// não é a falta do treinamento em si, é não conseguir provar que ele existe e
// está válido. Por isso a conformidade é modelada como REQUISITO x EVIDÊNCIA:
//
//   RequisitoNR      -> o que a FUNÇÃO exige (NR-10 para eletricista, NR-35
//                       para quem sobe em poste), com a periodicidade da
//                       reciclagem;
//   CertificadoNR    -> a evidência de que UMA PESSOA cumpriu aquele requisito,
//                       com validade própria;
//   ExameOcupacional -> o ASO do PCMSO, que segue a mesma lógica de validade.
//
// Quem está em dia, vencendo ou irregular é DERIVADO do cruzamento dos dois
// (lib/conformidade.ts) — não existe campo "situação" para alguém manter
// atualizado à mão, que é onde esse tipo de controle costuma apodrecer.

model RequisitoNR {
  id            String   @id @default(cuid())
  empresaId     String
  posicaoId     String
  posicao       Posicao  @relation(fields: [posicaoId], references: [id], onDelete: Cascade)
  // Código da norma ("NR-10", "NR-35", ...) — ver NORMAS_REGULAMENTADORAS em
  // lib/constants-sst.ts.
  norma         String
  // Periodicidade da reciclagem em meses (NR-35 e NR-10 básico: 24; NR-10 SEP:
  // 12). Null = treinamento sem reciclagem obrigatória.
  validadeMeses Int?
  observacoes   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([posicaoId, norma])
  @@index([empresaId])
  @@schema("rh")
}

model CertificadoNR {
  id            String      @id @default(cuid())
  empresaId     String
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  norma         String
  realizadoEm   DateTime
  // Calculado na gravação a partir de realizadoEm + validadeMeses do requisito,
  // mas gravado: a periodicidade pode mudar depois e isso não pode reescrever
  // a validade de um certificado já emitido.
  validoAte     DateTime?
  cargaHoraria  Int?
  instrutor     String?
  observacoes   String?
  arquivoId     String?     @unique
  arquivo       Arquivo?    @relation(fields: [arquivoId], references: [id], onDelete: SetNull)
  criadoPorId   String?
  criadoPorNome String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([colaboradorId, norma])
  @@index([empresaId, validoAte])
  @@schema("rh")
}

model ExameOcupacional {
  id            String      @id @default(cuid())
  empresaId     String
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  // ADMISSIONAL | PERIODICO | DEMISSIONAL | RETORNO_TRABALHO | MUDANCA_FUNCAO
  tipo          String
  realizadoEm   DateTime
  validoAte     DateTime?
  // APTO | APTO_COM_RESTRICAO | INAPTO
  resultado     String
  restricoes    String?
  medico        String?
  crm           String?
  clinica       String?
  observacoes   String?
  arquivoId     String?     @unique
  arquivo       Arquivo?    @relation(fields: [arquivoId], references: [id], onDelete: SetNull)
  criadoPorId   String?
  criadoPorNome String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([colaboradorId, realizadoEm])
  @@index([empresaId, validoAte])
  @@schema("rh")
}

// Ficha de entrega de EPI (NR-06): cada entrega/troca de equipamento, com o CA
// (Certificado de Aprovação) do item — não da pessoa — e a confirmação de que
// o colaborador assinou o recebimento. `validoAte` é a troca periódica do
// ITEM (ex.: protetor auricular a cada 6 meses), não confundir com a validade
// do CA junto ao governo, que este cadastro não acompanha.
model EntregaEPI {
  id            String      @id @default(cuid())
  empresaId     String
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  tipo          String
  ca            String?
  fabricante    String?
  quantidade    Int         @default(1)
  dataEntrega   DateTime
  validadeMeses Int?
  validoAte     DateTime?
  // PRIMEIRA_ENTREGA | TROCA_PERIODICA | REPOSICAO_DANO | REPOSICAO_PERDA
  motivo        String      @default("PRIMEIRA_ENTREGA")
  // Confirmação de que o colaborador assinou o recebimento — a ficha assinada
  // é o que a fiscalização pede, não o cadastro em si.
  assinado      Boolean     @default(false)
  observacoes   String?
  arquivoId     String?     @unique
  arquivo       Arquivo?    @relation(fields: [arquivoId], references: [id], onDelete: SetNull)
  criadoPorId   String?
  criadoPorNome String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([colaboradorId, tipo])
  @@index([empresaId, validoAte])
  @@schema("rh")
}

// Coisas que a empresa ENTREGA ao colaborador — cartão de benefícios,
// notebook, uniforme, crachá, chip — com a confirmação de recebimento vinda
// DA PESSOA, não do RH.
//
// POR QUE NÃO REAPROVEITOU O EntregaEPI. Aquela é a ficha da NR-06: tem CA e
// fabricante, e é o que a fiscalização do trabalho lê. Enfiar cartão de
// benefício ali polui um registro legal com dado que não é dele.
//
// POR QUE NÃO É O CHECKLIST DE ADMISSÃO. O checklist tem "Entrega do
// notebook" como TAREFA a fazer, marcada pelo RH. Isto é INVENTÁRIO: o que a
// pessoa tem agora, e a prova de que ela mesma confirmou ter recebido. São
// perguntas diferentes, e a segunda ninguém respondia.
//
// A CONFIRMAÇÃO É DO COLABORADOR, pelo portal. O cartão de benefícios recebe
// comissão e premiação: a confirmação deixa de ser burocracia e vira controle
// financeiro — prova de que a pessoa recebeu o cartão onde o dinheiro dela
// cai. RH marcando "entreguei" sozinho prova o que o RH diz, não o que a
// pessoa recebeu.
//
// `devolvidoEm` existe porque notebook volta e cartão não. Sem ele, "o que
// esta pessoa tem hoje" não teria resposta — e é justamente o que o checklist
// de desligamento precisa perguntar.
model EntregaAoColaborador {
  id              String      @id @default(cuid())
  empresaId       String
  colaboradorId   String
  colaborador     Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  /// Rótulo livre vindo do catálogo TIPO_ENTREGA (CatalogoItem) — nenhum
  /// código compara o valor para decidir fluxo, então o RH cadastra novos
  /// tipos sem deploy.
  tipo            String
  /// O item concreto: "Alelo final 4472", "Dell i5 · patrimônio 118".
  descricao       String?
  quantidade      Int         @default(1)
  dataEntrega     DateTime
  observacoes     String?
  /// Quando o COLABORADOR confirmou pelo portal. Nulo = ainda não confirmou.
  confirmadoEm    DateTime?
  /// Evidência de onde veio a confirmação — a mesma ideia do ponto.
  confirmadoIp    String?
  /// Preenchido quando o item volta (notebook, crachá). Cartão e uniforme
  /// ficam nulos para sempre.
  devolvidoEm     DateTime?
  entreguePorId   String?
  entreguePorNome String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([empresaId, tipo])
  @@index([colaboradorId])
  /// A fila "quem ainda não confirmou" é lida a cada abertura da tela.
  @@index([empresaId, confirmadoEm])
  @@schema("rh")
}

// Registro de acidente de trabalho / CAT (Comunicação de Acidente de
// Trabalho). A CAT precisa ser emitida ao INSS em até 1 dia útil (imediata se
// fatal) — os campos de emissão (catEmitida/catNumero/catEmitidaEm) existem
// para o RH provar que cumpriu o prazo, não para o sistema emitir a CAT em si
// (isso continua sendo feito no site do governo).
//
// `ausenciaId` liga o acidente ao afastamento correspondente quando houve
// (Ausencia.tipo = "ACIDENTE_TRABALHO", já modelado na Fase 1) — mas o
// acidente pode existir sem afastamento (sem gravidade que tire do trabalho) e
// por isso o vínculo é opcional.
model AcidenteTrabalho {
  id                 String      @id @default(cuid())
  empresaId          String
  colaboradorId      String
  colaborador        Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  dataHora           DateTime
  // TIPICO | TRAJETO | DOENCA_OCUPACIONAL
  tipo               String
  local              String?
  descricao          String
  parteCorpoAtingida String?
  natureza           String?
  houveAfastamento   Boolean     @default(false)
  ausenciaId         String?     @unique
  ausencia           Ausencia?   @relation(fields: [ausenciaId], references: [id], onDelete: SetNull)
  catEmitida         Boolean     @default(false)
  catNumero          String?
  catEmitidaEm       DateTime?
  testemunhas        String?
  medidasCorretivas  String?
  // EM_INVESTIGACAO | CONCLUIDO
  situacao           String      @default("EM_INVESTIGACAO")
  arquivoId          String?     @unique
  arquivo            Arquivo?    @relation(fields: [arquivoId], references: [id], onDelete: SetNull)
  registradoPorId    String?
  registradoPorNome  String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([empresaId, dataHora])
  @@index([colaboradorId, dataHora])
  @@schema("rh")
}

// Escala de turno do campo — quem está de plantão em cada dia, sem entrar em
// cálculo de hora extra ou banco de horas (isso fica para um módulo futuro de
// ponto/folha). Uma linha por (colaborador, dia): reatribuir o turno de
// alguém num dia é update, não um novo registro empilhado.
model EscalaTurno {
  id            String      @id @default(cuid())
  empresaId     String
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  // Dia da escala, meia-noite UTC (é uma data de calendário, não um instante).
  data          DateTime
  // MANHA | TARDE | NOITE | INTEGRAL | PLANTAO | FOLGA | OUTRO
  turno         String
  observacoes   String?
  criadoPorId   String?
  criadoPorNome String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([colaboradorId, data])
  @@index([empresaId, data])
  @@schema("rh")
}

// ------------------------------------------------------
// EVENTOS VARIÁVEIS DA FOLHA — FASE 5
// ------------------------------------------------------
// O que muda todo mês e a contabilidade precisa receber: hora extra, falta,
// adicional, bônus, desconto. NÃO é folha de pagamento — este sistema não
// calcula salário, INSS nem IRRF. Ele consolida o que o RH sabe e a folha
// (Domínio, via escritório contábil) não tem como saber sozinha.
//
// Horas extras são LANÇADAS À MÃO: quando a operação escolheu escala de
// plantão em vez de ponto eletrônico, o sistema ficou sem fonte de horas.
// Melhor o RH digitar o total do mês do que fingir um cálculo sem dado.

model CompetenciaFolha {
  id             String    @id @default(cuid())
  empresaId      String
  // Mês de referência, sempre dia 1 em UTC (é competência, não data exata).
  referencia     DateTime
  // ABERTA | FECHADA — fechada trava lançamento, para o que foi exportado
  // não mudar por baixo depois que o escritório já recebeu.
  status         String    @default("ABERTA")
  fechadaEm      DateTime?
  fechadaPorId   String?
  fechadaPorNome String?
  observacoes    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  eventos EventoFolha[]

  @@unique([empresaId, referencia])
  @@index([empresaId, status])
  @@schema("rh")
}

model EventoFolha {
  id            String           @id @default(cuid())
  empresaId     String
  competenciaId String
  competencia   CompetenciaFolha @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  colaboradorId String
  colaborador   Colaborador      @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  // Catálogo em lib/constants-folha.ts (HORA_EXTRA_50, FALTA, BONUS, ...)
  tipo          String
  // Quantidade na unidade do tipo — horas, dias ou 1 para valor fechado.
  quantidade    Float?
  // Valor em reais, quando o tipo é em dinheiro (bônus, desconto).
  valor         Float?
  observacoes   String?
  // MANUAL (o RH digitou) | DERIVADO (o sistema trouxe de Ausencia/Benefício).
  // Derivado é recalculável; manual, não — por isso a distinção importa na
  // hora de regerar a competência.
  origem        String           @default("MANUAL")
  criadoPorId   String?
  criadoPorNome String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([competenciaId, colaboradorId])
  @@index([empresaId, tipo])
  @@schema("rh")
}

// ------------------------------------------------------
// ONBOARDING — FASE 4
// ------------------------------------------------------
// Espelho do ChecklistDesligamento: mesma forma (item do catálogo + concluído
// + quem concluiu), do outro lado do ciclo de vida. Ganhou `responsavel` e
// `prazo` porque a integração é distribuída — TI cria acesso, almoxarifado
// entrega EPI, o gestor apresenta o time — enquanto a saída é quase toda do
// RH.

model ChecklistIntegracao {
  id               String      @id @default(cuid())
  empresaId        String
  colaboradorId    String
  colaborador      Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  // Catálogo em lib/constants-onboarding.ts | OUTRO
  item             String
  // Só usado/obrigatório quando item = OUTRO.
  descricao        String?
  // Texto livre: costuma ser uma área ("TI", "Almoxarifado"), não uma pessoa
  // do cadastro — por isso não é FK.
  responsavel      String?
  prazo            DateTime?
  concluido        Boolean     @default(false)
  concluidoEm      DateTime?
  concluidoPorId   String?
  concluidoPorNome String?
  observacoes      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([colaboradorId])
  @@index([empresaId, concluido])
  @@schema("rh")
}

// ------------------------------------------------------
// OFFBOARDING — FASE 3
// ------------------------------------------------------
// O motivo do desligamento já mora em Colaborador (Fase 1); aqui só o que
// falta: a devolução de ativos e os passos de saída (checklist) e a
// entrevista de desligamento. Devolução de ativo é só mais um item do
// checklist — não ganhou modelo próprio para não duplicar o conceito de
// "tarefa marcada como feita".

model ChecklistDesligamento {
  id               String      @id @default(cuid())
  empresaId        String
  colaboradorId    String
  colaborador      Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  // Catálogo em lib/constants-offboarding.ts (CRACHA, NOTEBOOK, EPI, ACESSO_SISTEMA, ...) | OUTRO
  item             String
  // Só usado/obrigatório quando item = OUTRO.
  descricao        String?
  concluido        Boolean     @default(false)
  concluidoEm      DateTime?
  concluidoPorId   String?
  concluidoPorNome String?
  observacoes      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([colaboradorId])
  @@index([empresaId, concluido])
  @@schema("rh")
}

// Uma por colaborador — quem sai mais de uma vez do grupo volta como um
// Colaborador novo neste modelo (não há reintegração aqui), então não há
// necessidade de histórico de várias entrevistas para o mesmo id.
model EntrevistaDesligamento {
  id                  String      @id @default(cuid())
  empresaId           String
  colaboradorId       String      @unique
  colaborador         Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  dataEntrevista      DateTime
  // Motivo REAL relatado na entrevista — pode diferir do motivoDesligamento
  // formal da ficha (ex.: formal "pedido de demissão", real "clima do setor").
  motivoReal          String?
  recomendariaEmpresa Boolean?
  // 1 a 5.
  satisfacaoGeral     Int?
  pontosPositivos     String?
  pontosMelhoria      String?
  observacoes         String?
  entrevistadoPorId   String?
  entrevistadoPorNome String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([empresaId, dataEntrevista])
  @@schema("rh")
}

// ------------------------------------------------------
// AVALIAÇÃO DE DESEMPENHO — FASE 3
// ------------------------------------------------------
// Ciclos 90/180/360°: 90 = só o gestor avalia (de cima para baixo); 180 =
// autoavaliação + gestor; 360 = os dois anteriores mais avaliadores extras
// (par/subordinado) escolhidos à mão — não há nomeação automática de pares.
// Competências vêm de um catálogo fixo (lib/constants-avaliacao.ts), no
// mesmo padrão dos catálogos de EPI/offboarding: não é preciso CRUD de
// competência por empresa para o escopo atual.

model CicloAvaliacao {
  id            String    @id @default(cuid())
  empresaId     String
  nome          String
  // "90" | "180" | "360" — ver nota acima.
  tipo          String
  dataInicio    DateTime
  dataFim       DateTime
  encerrado     Boolean   @default(false)
  encerradoEm   DateTime?
  criadoPorId   String?
  criadoPorNome String?
  createdAt     DateTime  @default(now())

  avaliacoes AvaliacaoDesempenho[]

  @@index([empresaId, encerrado])
  @@schema("rh")
}

// Uma linha por (colaborador avaliado, ciclo, avaliador). Para 90/180 nasce
// no máximo uma linha AUTOAVALIACAO e uma GESTOR por "Gerar avaliações"; para
// 360 o RH acrescenta PAR/SUBORDINADO à mão pelo botão de avaliador extra.
model AvaliacaoDesempenho {
  id            String         @id @default(cuid())
  empresaId     String
  colaboradorId String
  colaborador   Colaborador    @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  cicloId       String
  ciclo         CicloAvaliacao @relation(fields: [cicloId], references: [id], onDelete: Cascade)

  // AUTOAVALIACAO | GESTOR | PAR | SUBORDINADO
  tipoAvaliador String
  // Referência solta (não FK) — o mesmo padrão de ator usado em toda a base:
  // preserva o nome de quem avaliou mesmo que o colaborador-avaliador seja
  // excluído depois.
  avaliadorId   String
  avaliadorNome String?

  // Média das notas por competência (1 a 5), calculada ao concluir.
  notaFinal Float?
  // Só preenchido na avaliação tipo GESTOR — é o eixo Y do nine-box.
  // BAIXO | MEDIO | ALTO
  potencial String?

  pontosFortes          String?
  pontosDesenvolvimento String?
  comentarios           String?

  // PENDENTE | CONCLUIDA
  status      String    @default("PENDENTE")
  concluidaEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notas NotaCompetencia[]

  @@unique([colaboradorId, cicloId, avaliadorId])
  @@index([empresaId, cicloId])
  @@index([colaboradorId])
  @@schema("rh")
}

model NotaCompetencia {
  id          String              @id @default(cuid())
  avaliacaoId String
  avaliacao   AvaliacaoDesempenho @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  // Chave do catálogo em lib/constants-avaliacao.ts.
  competencia String
  // 1 a 5.
  nota        Int

  @@unique([avaliacaoId, competencia])
  @@schema("rh")
}

// ------------------------------------------------------
// METAS & PDI — FASE 3
// ------------------------------------------------------
// Meta é individual OU de setor, nunca as duas — a constraint CHECK na
// migration garante isso no banco, não só na action. PDI é uma lista de
// ações por colaborador (mesmo formato do ChecklistDesligamento): cada linha
// é um item que se marca como concluído, não um documento único.

model Meta {
  id            String       @id @default(cuid())
  empresaId     String
  colaboradorId String?
  colaborador   Colaborador? @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  setorId       String?
  setor         Setor?       @relation(fields: [setorId], references: [id], onDelete: Cascade)
  titulo        String
  descricao     String?
  dataInicio    DateTime
  dataFim       DateTime
  // 0 a 100 — atualizado à mão pelo RH/gestor, não calculado.
  progresso     Int          @default(0)
  // EM_ANDAMENTO | ATINGIDA | NAO_ATINGIDA | CANCELADA
  status        String       @default("EM_ANDAMENTO")
  criadoPorId   String?
  criadoPorNome String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([empresaId, colaboradorId])
  @@index([empresaId, setorId])
  @@index([empresaId, status])
  @@schema("rh")
}

model PlanoDesenvolvimento {
  id               String      @id @default(cuid())
  empresaId        String
  colaboradorId    String
  colaborador      Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  titulo           String
  descricao        String?
  prazo            DateTime?
  concluido        Boolean     @default(false)
  concluidoEm      DateTime?
  concluidoPorId   String?
  concluidoPorNome String?
  criadoPorId      String?
  criadoPorNome    String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([empresaId, colaboradorId])
  @@index([empresaId, concluido])
  @@schema("rh")
}

// ------------------------------------------------------
// TREINAMENTOS & TRILHAS (não-NR) — FASE 3
// ------------------------------------------------------
// "Não-NR" porque a capacitação obrigatória de segurança (NR-10, NR-35, ...)
// já mora em RequisitoNR/CertificadoNR desde a Fase 2 — isto aqui é
// desenvolvimento profissional geral: cursos, workshops, trilhas internas.
// A "matriz de competências" do roadmap não ganhou modelo próprio: é uma
// leitura sobre `Treinamento.competencias` (mesmo catálogo fixo da avaliação
// de desempenho, lib/constants-avaliacao.ts) cruzada com quem participou.

model Treinamento {
  id           String   @id @default(cuid())
  empresaId    String
  nome         String
  descricao    String?
  categoria    String?
  cargaHoraria Int?
  // Chaves de lib/constants-avaliacao.ts (COMPETENCIAS) — o que este
  // treinamento desenvolve, usado só na matriz de competências.
  competencias String[] @default([])
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())

  participacoes ParticipacaoTreinamento[]

  @@unique([empresaId, nome])
  @@index([empresaId, ativo])
  @@schema("rh")
}

model ParticipacaoTreinamento {
  id                 String      @id @default(cuid())
  empresaId          String
  colaboradorId      String
  colaborador        Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  treinamentoId      String
  treinamento        Treinamento @relation(fields: [treinamentoId], references: [id], onDelete: Cascade)
  dataRealizacao     DateTime
  presente           Boolean     @default(true)
  // 1 a 5, opcional — nota de avaliação/aproveitamento do treinamento.
  notaAvaliacao      Int?
  certificadoEmitido Boolean     @default(false)
  arquivoId          String?     @unique
  arquivo            Arquivo?    @relation(fields: [arquivoId], references: [id], onDelete: SetNull)
  observacoes        String?
  registradoPorId    String?
  registradoPorNome  String?
  createdAt          DateTime    @default(now())

  @@unique([colaboradorId, treinamentoId, dataRealizacao])
  @@index([empresaId, colaboradorId])
  @@index([empresaId, treinamentoId])
  @@schema("rh")
}

// ------------------------------------------------------
// RECRUTAMENTO & SELEÇÃO (ATS) — FASE 4
// ------------------------------------------------------
// `Candidato` existe independente de vaga — é o banco de talentos: quem foi
// reprovado numa vaga continua cadastrado e pode ser reaproveitado noutra sem
// recadastrar. `Candidatura` é o cruzamento candidato × vaga, com a etapa
// atual do funil; `EventoCandidatura` guarda o histórico dessas mudanças
// (mesmo par foto/filme de Movimentacao na Fase 2).

model Vaga {
  id            String    @id @default(cuid())
  empresaId     String
  titulo        String
  setorId       String?
  setor         Setor?    @relation(fields: [setorId], references: [id], onDelete: SetNull)
  posicaoId     String?
  posicao       Posicao?  @relation(fields: [posicaoId], references: [id], onDelete: SetNull)
  descricao     String?
  requisitos    String?
  tipoContrato  String?
  // Texto livre ("a combinar", "R$ 2.000 a 2.500") — de propósito não é
  // número: faixa salarial em vaga pública é decisão de negócio, não cálculo.
  faixaSalarial String?
  quantidade    Int       @default(1)
  // ABERTA | PAUSADA | ENCERRADA
  status        String    @default("ABERTA")
  // Endereço da página pública de inscrição (/vagas/<slug>). Sempre gerado,
  // mas só serve enquanto `publicada` for true e o status for ABERTA.
  slug          String    @unique
  publicada     Boolean   @default(false)
  abertaEm      DateTime  @default(now())
  encerradaEm   DateTime?
  criadoPorId   String?
  criadoPorNome String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  candidaturas Candidatura[]

  @@index([empresaId, status])
  @@schema("rh")
}

model Candidato {
  id              String    @id @default(cuid())
  empresaId       String
  nome            String
  cpf             String?
  email           String?
  telefone        String?
  cidade          String?
  linkedin        String?
  observacoes     String?
  // Currículo anexado (bytea em Arquivo, como todo anexo do sistema).
  arquivoId       String?   @unique
  arquivo         Arquivo?  @relation(fields: [arquivoId], references: [id], onDelete: SetNull)
  // PUBLICO (inscreveu-se sozinho pela página da vaga) | RH | INDICACAO
  origem          String    @default("RH")
  // LGPD: quando o candidato aceitou o uso dos dados, na inscrição pública.
  // Nulo para quem o RH cadastrou à mão — nesse caso o consentimento é papel,
  // fora do sistema.
  consentimentoEm DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  candidaturas Candidatura[]

  // CPF nulo não colide (Postgres trata NULL como distinto), então o RH pode
  // cadastrar candidato sem CPF; a inscrição pública exige, e é isso que
  // impede a mesma pessoa de se inscrever duas vezes.
  @@unique([empresaId, cpf])
  @@index([empresaId, nome])
  @@schema("rh")
}

model Candidatura {
  id            String    @id @default(cuid())
  empresaId     String
  vagaId        String
  vaga          Vaga      @relation(fields: [vagaId], references: [id], onDelete: Cascade)
  candidatoId   String
  candidato     Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  // TRIAGEM | ENTREVISTA | TESTE | PROPOSTA | CONTRATADO | REPROVADO | DESISTIU
  etapa         String    @default("TRIAGEM")
  motivo        String?
  observacoes   String?
  // Preenchido quando a candidatura vira admissão — liga o candidato à ficha
  // criada. Referência solta (sem FK): excluir o colaborador não pode apagar
  // o histórico do processo seletivo.
  colaboradorId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  eventos EventoCandidatura[]

  @@unique([vagaId, candidatoId])
  @@index([empresaId, etapa])
  @@index([candidatoId])
  @@schema("rh")
}

model EventoCandidatura {
  id                String      @id @default(cuid())
  candidaturaId     String
  candidatura       Candidatura @relation(fields: [candidaturaId], references: [id], onDelete: Cascade)
  etapaAnterior     String?
  etapaNova         String
  motivo            String?
  registradoPorId   String?
  registradoPorNome String?
  createdAt         DateTime    @default(now())

  @@index([candidaturaId, createdAt])
  @@schema("rh")
}

// Módulo de Medidas Disciplinares e Ocorrências em desfavor do colaborador
model OcorrenciaDisciplinar {
  id             String  @id @default(cuid())
  empresaId      String
  colaboradorId  String
  emitidoPorId   String?
  emitidoPorNome String?

  // ADVERTENCIA_VERBAL | ADVERTENCIA_ESCRITA | SUSPENSAO | JUSTA_CAUSA |
  // ABANDONO_EMPREGO | USO_INDEVIDO_EPI | DANO_PATRIMONIAL | RECUSA_EXAME
  tipo     String
  motivo   String
  detalhes String?
  dataFato DateTime

  diasSuspensao Int?
  valorDesconto Float?

  // PENDENTE | ASSINADO | RECUSADO_COM_TESTEMUNHAS
  statusAssinatura String    @default("PENDENTE")
  dataAssinatura   DateTime?

  testemunha1Nome String?
  testemunha1Cpf  String?
  testemunha2Nome String?
  testemunha2Cpf  String?

  documentoUrl String?

  // A VIA ASSINADA, digitalizada. O sistema gera o documento em branco e
  // registra `statusAssinatura`, mas até 11/08/2026 não havia onde guardar o
  // papel de volta: o RH imprimia, colhia a assinatura e o comprovante ficava
  // na pasta física. Numa reclamatória o que se pede é justamente esse papel —
  // o status sozinho é a afirmação de que ele existe, não a prova.
  arquivoId String?  @unique
  arquivo   Arquivo? @relation(fields: [arquivoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@index([empresaId, tipo])
  @@index([colaboradorId])
  @@schema("rh")
}

// ------------------------------------------------------
// PORTAL DO COLABORADOR — acesso sem senha
// ------------------------------------------------------
// O colaborador não tem usuário no sistema (são 400+ pessoas em campo). Quem
// autentica é o bot do Telegram, que já provou a identidade no vínculo do
// chat_id: a pessoa pede /portal e recebe, só naquele chat, um link de vida
// curta e uso único. Abrir o link troca o token por uma sessão em cookie.
//
// Os tokens são guardados como SHA-256, nunca em claro: um vazamento do banco
// não pode virar acesso ao portal (diferente do SurveyToken, que é um link
// permanente para uma pesquisa anônima — risco de outra ordem).

model PortalAcesso {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  tokenHash     String      @unique
  expiraEm      DateTime
  usadoEm       DateTime?
  canal         String      @default("TELEGRAM")
  createdAt     DateTime    @default(now())

  @@index([colaboradorId, usadoEm])
  @@schema("rh")
}

model PortalSessao {
  id             String      @id @default(cuid())
  colaboradorId  String
  colaborador    Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  tokenHash      String      @unique
  expiraEm       DateTime
  encerradaEm    DateTime?
  // Tentativas erradas na confirmação de CPF. Estouradas, a sessão é encerrada
  // e a pessoa precisa pedir um link novo ao bot.
  tentativasCpf  Int         @default(0)
  criadaEm       DateTime    @default(now())
  ultimoAcessoEm DateTime    @default(now())

  @@index([colaboradorId, encerradaEm])
  @@schema("rh")
}

// Sessão do app de ponto (/ponto), aberta por CPF + PIN — SEPARADA de
// PortalSessao de propósito: para o colaborador são dois sistemas (portal =
// contrato de trabalho, ponto = bater ponto), e esta sessão nunca pode abrir
// documentos, salário ou o Fale com o RH. Mesmo desenho de segurança do
// portal: só o SHA-256 do token no banco.
model PontoSessao {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  tokenHash     String      @unique
  expiraEm      DateTime
  encerradaEm   DateTime?
  criadaEm      DateTime    @default(now())

  @@index([colaboradorId, encerradaEm])
  @@schema("rh")
}

// Mensagem que o colaborador manda ao RH pelo portal — dúvida, pedido,
// aviso. O RH responde pela tela Mensagens e a resposta volta a aparecer no
// portal da pessoa. respondidaPorNome é denormalizado (como Sinal.donoNome):
// User não tem vínculo com Colaborador e o nome de quem respondeu precisa
// sobreviver a usuário renomeado ou removido.
model MensagemPortal {
  id                String      @id @default(cuid())
  colaboradorId     String
  colaborador       Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  empresaId         String
  mensagem          String
  resposta          String?
  respondidaEm      DateTime?
  respondidaPorNome String?
  createdAt         DateTime    @default(now())

  @@index([empresaId, respondidaEm])
  @@index([colaboradorId])
  @@schema("rh")
}

// Uma linha por cobrança de cadastro enviada ao colaborador pelo Telegram
// (lib/cobranca-cadastro-colaborador.ts). É o relógio da cadência: sem ela o
// cron não sabe quem já foi cobrado e mandaria a mesma mensagem todo dia.
//
// Histórico, não estado: linha por envio em vez de dois campos na ficha
// ("últimaCobrançaEm", "rodadas"). Quando o colaborador reclamar que "o RH
// nunca me avisou", o que responde é a lista do que foi pedido e quando —
// `itens` guarda exatamente o que estava faltando naquele dia.
model CobrancaCadastro {
  id                String      @id @default(cuid())
  colaboradorId     String
  colaborador       Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  empresaId         String
  /// 1ª, 2ª… cobrança desta pessoa. Para em MAX_COBRANCAS.
  rodada            Int
  /// O que faltava no momento do envio, nos mesmos rótulos que a pessoa leu.
  itens             String
  /// Por onde saiu: "TELEGRAM", "EMAIL" ou "TELEGRAM,EMAIL". Só canais que
  /// ACEITARAM o envio entram — a linha é prova de que a pessoa foi avisada, e
  /// registrar um canal que recusou transformaria a prova em ficção.
  canais            String      @default("TELEGRAM")
  /// Disparada por alguém do RH pela tela, em vez do cron. Não conta para o
  /// teto de MAX_COBRANCAS nem mexe no relógio da cobrança automática: é um
  /// extra por cima dela, decidido por uma pessoa, e não pode encurtar a
  /// campanha de quem foi cobrado à mão uma vez.
  manual            Boolean     @default(false)
  /// Quem clicou, quando `manual`. Snapshot do nome, como no resto da trilha:
  /// apagar o usuário não pode apagar a autoria do que ele disparou.
  solicitadaPorNome String?
  enviadaEm         DateTime    @default(now())

  @@index([colaboradorId, enviadaEm])
  @@index([empresaId, enviadaEm])
  @@schema("rh")
}

// Histórico de importações em massa (Fase 6, etapa C). Guarda o RESUMO de
// cada planilha processada — contagens e quem subiu — nunca o conteúdo: o
// arquivo pode ter CPF e salário, e replicá-lo aqui viraria uma segunda base
// de dado pessoal fora da ficha.
model ImportacaoArquivo {
  id            String   @id @default(cuid())
  empresaId     String
  arquivoNome   String
  tipo          String // "COLABORADORES" (outros tipos entram quando existirem)
  totalLinhas   Int
  criados       Int
  atualizados   Int
  comErro       Int
  // Ator em referência branda, como no resto do sistema: apagar o usuário não
  // pode apagar o histórico do que foi importado.
  criadoPorId   String?
  criadoPorNome String?
  createdAt     DateTime @default(now())

  @@index([empresaId, createdAt])
  @@schema("rh")
}

// Trilha de auditoria LGPD: quem viu/alterou dado pessoal e quando. Append-only
// por convenção — nada no app atualiza ou apaga registros daqui.
model AuditLog {
  id          String   @id @default(cuid())
  empresaId   String?
  usuarioId   String?
  usuarioNome String?
  usuarioRole String?
  acao        String
  entidade    String
  entidadeId  String?
  resumo      String
  detalhes    Json?
  createdAt   DateTime @default(now())

  @@index([empresaId, createdAt])
  @@index([entidade, entidadeId])
  @@schema("rh")
}

model Pesquisa {
  id          String    @id @default(cuid())
  // A pesquisa é da MARCA, não do CNPJ: uma de clima é aplicada ao grupo
  // inteiro, e qual CNPJ assina a carteira de quem responde não muda nada para
  // quem conduz. Enquanto o vínculo era só `empresaId`, uma pesquisa criada na
  // RSM sumia para os outros quatro CNPJs da LM Telecom — sem avisar que estava
  // escondendo — e criar "uma por CNPJ" enchia a lista de duplicatas.
  marcaId     String
  marca       Marca     @relation(fields: [marcaId], references: [id])
  // Mantido: registra em qual CNPJ a pesquisa nasceu e ainda é lido por telas
  // e relatórios antigos. Sai numa limpeza posterior, quando ninguém mais usar.
  empresaId   String
  empresa     Empresa   @relation(fields: [empresaId], references: [id])
  titulo      String
  descricao   String?
  // "CLIMA" (pesquisa livre/GPTW) | "NR01" (avaliação de riscos psicossociais
  // NR-01/PGR — perguntas fixas de lib/nr01-modelo.ts, motor em lib/nr01.ts).
  modelo      String    @default("CLIMA")
  // Regra de Ouro do Anonimato: quando true, Resposta nunca grava colaboradorId.
  anonima     Boolean   @default(true)
  status      String    @default("DRAFT")
  criadoPorId String?
  criadoPor   User?     @relation(fields: [criadoPorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  iniciadaEm  DateTime?
  encerradaEm DateTime?

  // Cache do resultado NR-01 (lib/nr01.ts, resultado.geral), preenchido só no
  // instante em que a pesquisa vira FINISHED (lib/actions/pesquisas.ts). Uma
  // pesquisa encerrada não recebe resposta nova — recalcular a cada visita de
  // /relatorios era refazer sempre a mesma conta. Ambos nulos para pesquisa
  // CLIMA (o modelo não tem esse índice) ou NR01 ainda ACTIVE/DRAFT.
  nivelGeralCache  String?
  indiceGeralCache Int?

  perguntas  Pergunta[]
  tokens     SurveyToken[]
  respostas  Resposta[]
  planosAcao PlanoAcao[]

  // FORA DO PRISMA: índice único parcial Pesquisa_marcaId_titulo_key —
  // UNIQUE (marcaId, titulo) WHERE status = 'DRAFT' (migração
  // 20260802150000). Rede de segurança contra rascunho de ciclo duplicado:
  // em 31/07/2026 uma execução do cron criou um "Pulso de Clima 2026 T3" por
  // CNPJ e o RH apagou os excedentes à mão. Parcial de propósito: as
  // campanhas permanentes por evento (P06-ONB30, P09-OFF) nascem ACTIVE com
  // título fixo e são recriadas legitimamente com o mesmo título quando a
  // anterior encerra — um UNIQUE cheio quebraria essa recriação. Não é
  // @@unique porque o Prisma não representa índice parcial; o cron re-checa
  // antes de criar (lib/pesquisa-ciclo.ts) e as ações de criação/renomeio
  // traduzem a violação em mensagem amigável (lib/actions/pesquisas.ts).

  // A listagem passou a filtrar por marca; o índice acompanha. O de empresaId
  // fica enquanto as telas antigas ainda leem por CNPJ.
  @@index([marcaId, status])
  @@index([empresaId, status])
  @@index([criadoPorId])
  @@schema("rh")
}

// Ação corretiva rastreável nascida de uma pesquisa (RD-001 seed, fase 2 do
// roadmap de 02/08/2026: catálogo de tipos + plano de ação). Hoje esse "plano"
// é só texto estático dentro do PDF do NR-01 (`PLANO_ACAO_NR01`) — sem dono,
// prazo nem status, então não dá pra saber se foi feito. Isto substitui esse
// texto por registro de verdade.
//
// RACI do seed: quem ELABORA e EXECUTA é o gestor da área, quem APROVA é a
// diretoria — por isso `responsavelId/Nome` segue o mesmo padrão solto de
// `ChecklistDesligamento`/`EntrevistaDesligamento` (texto livre, não FK
// obrigatória pra User: nem todo responsável de ação é usuário do sistema).
//
// "Vencido" (alerta AL09 do seed, meta `planos_acao_no_prazo_pct`) é
// DERIVADO (`prazo < hoje && status not in [CONCLUIDO, CANCELADO]`), não um
// status gravado — evita placar desatualizado se ninguém abrir a tela.
model PlanoAcao {
  id              String    @id @default(cuid())
  empresaId       String
  empresa         Empresa   @relation(fields: [empresaId], references: [id])
  pesquisaId      String?
  pesquisa        Pesquisa? @relation(fields: [pesquisaId], references: [id], onDelete: SetNull)
  setorId         String?
  setor           Setor?    @relation(fields: [setorId], references: [id], onDelete: SetNull)
  // Vocabulário de dimensão varia por tipo de pesquisa (A-H no NR-01,
  // dimensões GPTW no Clima) — texto livre, cada tipo do catálogo define o
  // seu (ver lib/pesquisas-catalogo.ts), não uma FK fixa.
  dimensaoCodigo  String?
  titulo          String
  descricao       String?
  responsavelId   String?
  responsavelNome String?
  prazo           DateTime
  status          String    @default("ABERTO") // ABERTO | EM_ANDAMENTO | CONCLUIDO | CANCELADO
  concluidoEm     DateTime?
  // Preenchido só em CANCELADO — por que a ação não vai mais acontecer.
  motivoDecisao   String?
  criadoPorId     String?
  criadoPorNome   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([empresaId, status])
  @@index([pesquisaId])
  @@index([setorId, status])
  @@schema("rh")
}

// Central de Sinais: alerta COM ESTADO — dono, prazo e desfecho. Os detectores
// (lib/alertas.ts, lib/anomalias.ts via lib/sinais-registro.ts) gravam aqui
// 1×/dia pelo cron alertas-rh; a tela sinais/ é onde o humano responde com
// "reconheci", "virou plano" ou "descartei, e o motivo é este".
//
// Referências SOFT de propósito (donoUserId/donoNome, planoAcaoId, unidadeId +
// unidadeNome como snapshot), mesmo padrão de PlanoAcao.responsavel* e da
// trilha de auditoria: um cargo/setor apagado dois anos depois não pode quebrar
// o histórico de sinais nem reescrever o rótulo do que foi detectado.
model Sinal {
  id String @id @default(cuid())

  // Qual detector falou: ANOMALIA_DESLIGAMENTO | PLANO_VENCIDO |
  // DESLIGAMENTOS_CONCENTRADOS | TAXA_RESPOSTA_BAIXA (ver lib/sinais.ts).
  tipo String

  // Onde: GRUPO | MARCA | EMPRESA | SETOR, com snapshot do nome.
  nivelUnidade String
  unidadeId    String
  unidadeNome  String
  // CNPJ para o recorte da tela (empresasVisiveis). Nulo em sinal de
  // grupo/marca, que todo leitor da Central enxerga.
  empresaId    String?

  // Identidade da ocorrência — o cron atualiza a linha existente em vez de
  // criar outra (lib/sinais.ts::decidirRegistro). Índice simples, NÃO unique:
  // a mesma chave volta a existir quando um descarte envelhece.
  chaveDedupe String

  // A frase do cartão + observado × esperado como texto pronto — cada detector
  // tem unidade própria (%, dias, pessoas) e a tela não reformata número.
  titulo    String
  observado String
  esperado  String
  // O que ficou fora da conta, no rodapé do cartão. Honestidade de dado.
  recorte   String?

  gravidade String // CRITICA | ALTA | ATENCAO
  status    String @default("ABERTO") // ABERTO | RECONHECIDO | EM_PLANO | DESCARTADO | SILENCIADO

  // Preenchido só em DESCARTADO — descartar sem motivo escrito não existe.
  motivoDescarte String?

  // Dono é escolha MANUAL entre os usuários do sistema (soft ref + snapshot).
  donoUserId String?
  donoNome   String?
  prazo      DateTime?

  // Plano criado a partir deste sinal (status EM_PLANO), soft ref.
  planoAcaoId String?

  // Até quando este sinal nasceu calado (2+ descartes seguidos na unidade).
  silenciadoAte DateTime?

  detectadoEm  DateTime @default(now())
  // Última vez que o detector confirmou que a situação continua de pé.
  confirmadoEm DateTime @default(now())
  // Quando o status atual foi definido — é daqui que se conta a validade de um
  // descarte (SILENCIO_DIAS em lib/sinais.ts).
  statusEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // "Essa ocorrência já existe?" — a pergunta do cron a cada candidato.
  @@index([chaveDedupe])
  // "O que está aberto, por gravidade?" — a pergunta da tela.
  @@index([status, gravidade])
  // "Quantas vezes essa unidade já descartou esse tipo?" — a regra de silêncio.
  @@index([tipo, unidadeId])
  @@schema("rh")
}

model Pergunta {
  id           String   @id @default(cuid())
  pesquisaId   String
  pesquisa     Pesquisa @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)
  ordem        Int
  enunciado    String
  tipo         String   @default("LIKERT_5")
  dimensaoGPTW String?
  // Campos do modelo NR-01: código original da pergunta ("01".."35"),
  // dimensão psicossocial (DEMANDA, AUTONOMIA, SUPORTE_GESTOR,
  // SUPORTE_COLEGAS, CLIMA_CONFLITOS, CLAREZA_MUDANCAS) e flag de fator de
  // proteção (invertida = true -> risco = 4 - resposta).
  codigo       String?
  dimensao     String?
  invertida    Boolean  @default(false)
  obrigatoria  Boolean  @default(true)

  opcoes Opcao[]
  itens  RespostaItem[]

  @@unique([pesquisaId, ordem])
  @@index([pesquisaId])
  @@schema("rh")
}

model Opcao {
  id         String   @id @default(cuid())
  perguntaId String
  pergunta   Pergunta @relation(fields: [perguntaId], references: [id], onDelete: Cascade)
  ordem      Int
  texto      String

  itens RespostaItem[]

  @@index([perguntaId])
  @@schema("rh")
}

model SurveyToken {
  id            String      @id @default(cuid())
  pesquisaId    String
  pesquisa      Pesquisa    @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  // Gerado com crypto.randomBytes(24).toString("base64url") — imprevisível,
  // não apenas único, já que é a única "autenticação" da rota pública /responder.
  token         String      @unique
  canal         String      @default("TELEGRAM")
  status        String      @default("PENDING")
  enviadoEm     DateTime?
  respondidoEm  DateTime?
  erro          String?
  createdAt     DateTime    @default(now())

  @@unique([pesquisaId, colaboradorId])
  @@index([status])
  @@schema("rh")
}

// Nota: quando Pesquisa.anonima = true, Resposta NUNCA grava colaboradorId —
// só um snapshot de setor/posição no momento do envio, para o RH filtrar
// agregados sem identificar quem respondeu. Deliberadamente não há relação
// com SurveyToken aqui: saber "que alguém respondeu" (no token) é mantido
// separado de "o que essa pessoa respondeu" (aqui). Consultas de agregados
// por GESTOR_SETOR devem exigir amostra mínima de 3 respostas por
// (setor × pesquisa) antes de exibir qualquer número.
model Resposta {
  id                  String       @id @default(uuid())
  pesquisaId          String
  pesquisa            Pesquisa     @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)
  colaboradorId       String?
  colaborador         Colaborador? @relation(fields: [colaboradorId], references: [id])
  setorNomeSnapshot   String
  posicaoNomeSnapshot String
  // Demográficos agregáveis sem identificar o respondente (faixa etária em vez
  // de idade exata de propósito — setor pequeno + idade exata identificaria).
  sexoSnapshot        String?
  faixaEtariaSnapshot String?
  createdAt           DateTime     @default(now())

  itens RespostaItem[]

  @@index([pesquisaId])
  @@schema("rh")
}

model RespostaItem {
  id            String   @id @default(uuid())
  respostaId    String
  resposta      Resposta @relation(fields: [respostaId], references: [id], onDelete: Cascade)
  perguntaId    String
  pergunta      Pergunta @relation(fields: [perguntaId], references: [id])
  valorNumerico Int?
  valorTexto    String?
  opcaoId       String?
  opcao         Opcao?   @relation(fields: [opcaoId], references: [id])

  @@index([respostaId])
  @@index([perguntaId])
  @@index([opcaoId])
  @@schema("rh")
}

// ---------------------------------------------------------------------------
// Orçamento de e-mail
//
// Toda saída de e-mail do sistema passa por lib/email.ts e é registrada aqui —
// convite de pesquisa, lembrete, campanha do portal, notificação de ciclo e
// convite de usuário. Antes só os convites de pesquisa eram contados (via
// SurveyToken), e os outros quatro caminhos gastavam cota invisivelmente: em
// 28/07/2026 saíram 118+ e-mails num dia com teto de 100, porque a campanha do
// portal disparou ~60 sem aparecer para o contador.
//
// A conta do Resend é COMPARTILHADA com o lm-bonificacao e o teto de 100/dia é
// da conta, não da chave — por isso o orçamento aqui é deliberadamente menor.
model EmailEnviado {
  id        String   @id @default(cuid())
  // Sempre normalizado (trim + minúsculas) para o dedupe não vazar por
  // diferença de caixa.
  para      String
  assunto   String
  // Chave de deduplicação do dia. Duas tentativas com a mesma chave no mesmo
  // dia-calendário de Brasília só gastam cota uma vez — é o que impede o
  // reenvio manual pela tela de duplicar o que o cron já mandou.
  chave     String?
  ok        Boolean
  erro      String?
  enviadoEm DateTime @default(now())

  @@index([enviadoEm])
  @@index([chave, enviadoEm])
  @@schema("rh")
}

// Endereços que não devem mais receber nada. Bounce repetido queima cota todo
// dia e derruba a reputação do domínio `envios.assinelm.com.br` — que é o mesmo
// usado pelo lm-bonificacao.
model EmailSuprimido {
  email    String   @id
  motivo   String
  criadoEm DateTime @default(now())

  @@schema("rh")
}

// Credenciais que o ADMIN cadastra pela tela, em vez de exigir acesso à Vercel
// e um deploy novo a cada troca.
//
// `valor` é AES-256-GCM (lib/cripto.ts) com chave derivada do AUTH_SECRET —
// que vive só no ambiente. Um dump do banco (o backup diário inclusive) leva
// texto cifrado e nada mais. Em troca: TROCAR O AUTH_SECRET INVALIDA TUDO
// AQUI, e a credencial precisa ser cadastrada de novo.
//
// `dica` guarda os últimos caracteres em claro, e só isso. A tela precisa
// mostrar QUAL chave está gravada sem nunca devolver a chave — nenhuma rota
// deste app lê `valor` para fora do servidor.
model SegredoApp {
  chave         String   @id
  valor         String
  dica          String
  atualizadoEm  DateTime @default(now()) @updatedAt
  atualizadoPor String?

  @@schema("rh")
}

// Horário dos crons "de comunicação" (alertas-rh, enviar-convites,
// lembrete-pesquisa, lembrete-portal) — não inclui backup-db nem
// gestao-ciclo-pesquisas, que são operacionais/internos, não avisos ao RH.
//
// vercel.json chama essas rotas a cada 15 min; cada uma decide, via
// lib/cron-horario.ts, se a chamada de agora cai dentro da janela de algum
// horário configurado aqui. Sem linha para uma `chave`, vale o horário
// padrão embutido no código (LEMBRETES_CONFIGURAVEIS) — o mesmo que já
// rodava fixo no vercel.json antes desta tabela existir.
//
// Uma `chave` pode ter mais de uma linha (lembrete-pesquisa roda 2×/dia hoje,
// 13h e 19h) — RH edita, adiciona ou remove horário por horário.
model ConfiguracaoLembrete {
  id            String   @id @default(cuid())
  chave         String
  horario       String // "HH:mm", horário de Brasília
  ativo         Boolean  @default(true)
  atualizadoEm  DateTime @default(now()) @updatedAt
  atualizadoPor String?

  @@unique([chave, horario])
  @@index([chave])
  @@schema("rh")
}

// Tentativas de login que falharam — base do limite de 5 em 15 min
// (lib/login-tentativas.ts). Uma linha por falha, não um contador na linha do
// User, por três motivos: o usuário digitado pode não existir (e aí não há
// linha para incrementar, mas é exatamente o caso que mais interessa barrar);
// a janela é deslizante, o que exige saber QUANDO cada falha aconteceu, não
// só quantas foram; e um contador em `User` seria escrita concorrente na
// mesma linha a cada tentativa — bom alvo de disputa justo no caminho quente.
//
// Não há relação com User de propósito: `username` aqui é o texto digitado,
// não uma chave estrangeira. Ele é normalizado (minúsculas, sem espaço nas
// pontas) antes de gravar, para "Marcelo " e "marcelo" caírem no mesmo balde.
//
// As linhas com mais de 24h são apagadas oportunisticamente a cada falha
// nova — sem cron próprio, porque a tabela só cresce quando alguém erra a
// senha e o volume não justifica mais uma rota agendada.
model TentativaLogin {
  id       String   @id @default(cuid())
  username String
  ip       String
  criadoEm DateTime @default(now())

  // A pergunta feita a cada login é "quantas falhas deste usuário, deste IP,
  // nos últimos 15 minutos" — a forma exata deste índice.
  @@index([username, ip, criadoEm])
  // A faxina pergunta só pela idade, sem usuário nem IP.
  @@index([criadoEm])
  @@schema("rh")
}

// Foto mensal: o histórico que o sistema não tinha.
//
// Todo "últimos 12 meses" que o Painel desenha hoje é RECONSTRUÍDO a partir de
// campos que o RH edita todo dia — lib/bi.ts::calcularTurnover deduz o
// headcount do início do período de trás para frente, justamente porque não
// existia snapshot. O efeito colateral é que o passado muda: corrigir três
// datas de desligamento na semana que vem reescreve o pico de junho/2026, e o
// cartão que a Diretoria viu na segunda não bate mais na sexta. Alerta que não
// se reproduz custa mais confiança do que falso positivo.
//
// Esta tabela é a memória. Uma linha por (competência × CNPJ × setor × cargo),
// GRAVADA UMA VEZ E NUNCA REESCRITA — a unicidade abaixo é o que torna o cron
// idempotente: rodar duas vezes no mesmo mês não duplica nem sobrescreve
// (lib/foto-mensal.ts usa `createMany({ skipDuplicates: true })`).
//
// REFERÊNCIAS SOFT (id + nome, sem @relation), o mesmo padrão da trilha de
// auditoria deste schema: um snapshot que muda quando o RH renomeia um setor
// SISTEMA DE PONTO — entrada/saída com selfie e localização
// Configuração da tolerância de horário por empresa

// ou apaga um cargo não é snapshot. O nome gravado aqui é o nome que aquele
// setor tinha NAQUELE mês; o id serve para reagrupar quando ele ainda existe.
// `marcaId`/`marcaNome` vêm junto pelo mesmo motivo — a tela filtra por marca
// (lib/escopo-marca.ts) e um CNPJ que trocar de marca não pode reescrever a
// série da marca antiga.
//
// Sobre dinheiro: `folhaSalarial` é `null`, NUNCA 0, quando ninguém do balde
// tem salário cadastrado — 49 dos 215 ativos não têm (Centrysol, VAPT,
// Mobility), e "R$ 0" ali seria mentira. `comSalario`/`semSalario` dizem de
// quantas pessoas a soma foi feita, para a tela poder marcar "parcial".
// PRIVACIDADE: num balde de 1 pessoa a folha É o salário dela — quem montar a
// tela trata esta coluna como salário (Diretoria/RH), não como agregado.
model FotoMensal {
  id          String @id @default(cuid())
  // "AAAA-MM" — o mês FECHADO a que a foto se refere, não o dia da captura.
  competencia String

  empresaId   String
  empresaNome String
  marcaId     String
  marcaNome   String
  setorId     String
  setorNome   String
  posicaoId   String
  posicaoNome String

  // Estoque: pessoas ativas no último dia da competência.
  headcount     Int
  // Fluxo do mês. Atribuídos ao setor/cargo/CNPJ que a pessoa tinha na hora da
  // captura — o cadastro não guarda o setor de origem de uma movimentação.
  admissoes     Int
  desligamentos Int

  // O que ficou de fora, gravado junto para nenhuma série nascer muda sobre o
  // próprio buraco. `headcountSemDataAdmissao`: ativos que nunca entram em
  // `admissoes` porque não têm data. `desligadosSemDataAcumulado`: desligados
  // deste balde sem data de desligamento (137 desligados, 31 sem data no
  // levantamento de 04/08/2026) — é SALDO ACUMULADO, não fluxo do mês; a
  // mesma pessoa reaparece em toda competência seguinte. NUNCA SOME ESSA
  // COLUNA AO LONGO DOS MESES: o nome é comprido de propósito.
  headcountSemDataAdmissao   Int
  desligadosSemDataAcumulado Int

  folhaSalarial Float?
  comSalario    Int
  semSalario    Int

  // Auditoria da própria foto: quando foi tirada e por qual versão do código.
  // A distância entre `capturadoEm` e o fim da `competencia` é o que denuncia
  // uma captura atrasada (cron que não rodou, recuperado à mão depois).
  capturadoEm DateTime @default(now())
  versaoApp   String

  // O contrato de idempotência do cron. Todas as quatro colunas são NOT NULL
  // de propósito: em Postgres, NULL não colide com NULL, e uma delas opcional
  // transformaria a trava em sugestão.
  @@unique([competencia, empresaId, setorId, posicaoId])
  // "a série inteira do grupo neste mês" e "a série deste CNPJ ao longo do
  // tempo" — as duas perguntas que a tela vai fazer.
  @@index([competencia])
  @@index([empresaId, competencia])
  @@schema("rh")
}

// ---------------------------------------------------------------------------
// PONTO ELETRÔNICO & GESTÃO DE JORNADA (REP-P / Portaria MTP 671/2021)
// ---------------------------------------------------------------------------

// Cadastro da escala / jornada contratual de trabalho
model JornadaTrabalho {
  id             String   @id @default(cuid())
  empresaId      String
  nome           String // Ex: "Administrativo 08h às 18h", "Turno 12x36"
  entrada1       String // "08:00"
  saida1         String // "12:00"
  entrada2       String? // "13:00"
  saida2         String? // "17:00"
  cargaDiariaMin Int      @default(480) // Carga diária contratual em minutos (ex: 480 min = 8h)
  toleranciaMin  Int      @default(10) // Tolerância diária em minutos (Art. 58 § 1º CLT)
  sabadoUtil     Boolean  @default(false)
  domingoUtil    Boolean  @default(false)
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([empresaId, ativo])
  @@schema("rh")
}

// Registro inalterável da batida de ponto (REP-P / Append-Only Log)
// Proibido UPDATE ou DELETE nas colunas de marcação original por exigência fiscal MTE.
model RegistroPonto {
  id              String      @id @default(cuid())
  empresaId       String
  colaboradorId   String
  colaborador     Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  dataHora        DateTime // Instante exato oficial (NTP/UTC-3)
  tipo            String // "ENTRADA_1" | "SAIDA_1" | "ENTRADA_2" | "SAIDA_2"
  nsr             BigInt // Número Sequencial de Registro (crescente por empresa)
  ipOrigem        String? // Endereço IP público do batimento
  ipValido        Boolean     @default(true)
  latitude        Float? // Coordenada GPS
  longitude       Float? // Coordenada GPS
  precisaoGps     Float? // Precisão em metros
  gpsValido       Boolean     @default(true)
  fotoUrl         String? // URL do Blob da foto tirada no momento (opcional)
  hashSHA256      String // Criptografia e integridade da marcação
  dispositivoInfo String? // User-agent / Navegador / SO
  createdAt       DateTime    @default(now())

  tratamentos TratamentoPonto[]

  @@index([empresaId, dataHora])
  @@index([colaboradorId, dataHora])
  @@index([empresaId, nsr])
  @@schema("rh")
}

// Tratamento de Inconsistências (PTRP - Programa de Tratamento de Registro de Ponto)
model TratamentoPonto {
  id              String         @id @default(cuid())
  empresaId       String
  colaboradorId   String
  colaborador     Colaborador    @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  registroPontoId String?
  registroPonto   RegistroPonto? @relation(fields: [registroPontoId], references: [id], onDelete: SetNull)
  dataFato        DateTime // Dia a que se refere a ocorrência
  tipo            String // ver TIPOS_TRATAMENTO_PONTO em lib/constants-ponto.ts
  motivo          String // Texto justificando a alteração
  // Quem abriu o pedido: "RH" (aba Tratamento) ou "COLABORADOR" (portal/app
  // de ponto, desde 21/08/2026). O colaborador pede, o RH decide — a coluna
  // existe para a tela do RH distinguir pedido recebido de ajuste próprio.
  origem          String         @default("RH")
  // Só nos pedidos de ajuste de marcação vindos do colaborador: qual marcação
  // deveria ter sido registrada e em que horário (de Brasília). Texto "HH:mm"
  // porque é um horário declarado pela pessoa, não um instante medido.
  tipoMarcacao    String? // "ENTRADA_1" | "SAIDA_1" | "ENTRADA_2" | "SAIDA_2"
  horaSolicitada  String? // "HH:mm"
  arquivoId       String?        @unique
  arquivo         Arquivo?       @relation(fields: [arquivoId], references: [id], onDelete: SetNull)
  status          String         @default("PENDENTE") // "PENDENTE" | "APROVADO" | "REJEITADO"
  aprovadoPorId   String?
  aprovadoPorNome String?
  aprovadoEm      DateTime?
  // Justificativa de QUEM DECIDIU, separada do `motivo` de quem pediu. Até
  // 11/08/2026 a recusa era concatenada dentro de `motivo` — o texto original
  // do solicitante era reescrito a cada rejeição, e num módulo fiscalizável
  // (Portaria MTP 671/2021) o registro do pedido não pode ser alterado por
  // quem o julga.
  motivoDecisao   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([empresaId, dataFato])
  @@index([colaboradorId, dataFato])
  // A fila de pendentes é lida a cada abertura da tela de Ponto e da Central
  // de Aprovações, sempre filtrando por empresa + status.
  @@index([empresaId, status])
  @@schema("rh")
}

// Extrato & Saldo de Banco de Horas
model BancoHoras {
  id            String      @id @default(cuid())
  empresaId     String
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  competencia   String // "AAAA-MM"
  saldoAnterior Int         @default(0) // Saldo acumulado em minutos
  creditosMes   Int         @default(0) // Horas extras enviadas ao banco no mês (minutos)
  debitosMes    Int         @default(0) // Faltas/atrasos/folgas compensadas no mês (minutos)
  saldoAtual    Int         @default(0) // Saldo final do mês (minutos)
  expiraEm      DateTime? // Prazo limite para compensação (6 a 12 meses)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([colaboradorId, competencia])
  @@index([empresaId, competencia])
  @@schema("rh")
}

// Configurações de Trava de Ponto da Empresa (IP, GPS, Cercos)
model ConfiguracaoPontoEmpresa {
  id                String   @id @default(cuid())
  empresaId         String   @unique
  empresa           Empresa  @relation(fields: [empresaId], references: [id])
  ipsAutorizados    String? // Lista de IPs públicos separados por vírgula
  exigirIp          Boolean  @default(false)
  latitudeEmpresa   Float? // Latitude da sede/unidade
  longitudeEmpresa  Float? // Longitude da sede/unidade
  raioPermitidoMtrs Int      @default(200) // Raio do cerco em metros
  // A cerca de GPS é OPT-IN: nasce DESLIGADA. Nasceu `true`, e com isso ligava
  // sozinha por efeito colateral — salvarLimiteEstagio e salvarTravaIpPonto
  // criam esta linha, e a empresa passava a exigir GPS com latitude e
  // longitude NULAS. registrarPontoPortal então recusava a batida de quem
  // tivesse negado a localização no celular ("Sua localização (GPS) é
  // obrigatória"), sem que ninguém tivesse cadastrado cerca nenhuma: uma trava
  // que não cerca lugar algum, só bloqueia gente.
  // Ligar a trava é caminho único: salvarGeofencingPonto, que já recusa
  // exigirGps=true sem coordenada.
  exigirGps         Boolean  @default(false)
  exigirFoto        Boolean  @default(false)
  // Teto de jornada do estagiário, em minutos. Configurável pelo RH na tela de
  // Ponto, mas NUNCA acima do teto legal (Lei 11.788/2008, art. 10: 6h/dia e
  // 30h/semana) — a validação está em lib/ponto-regras.ts::limitesDeEstagio, e
  // é ela que manda, não o valor da coluna: linha adulterada direto no banco
  // não afrouxa a regra.
  estagioMinDia     Int      @default(360)
  estagioMinSemana  Int      @default(1800)
  updatedAt         DateTime @updatedAt

  @@schema("rh")
}

/// Um aviso já enviado a um gestor sobre uma pessoa do time dele.
///
/// Existe só para SILENCIAR repetição: sem esta tabela o cron avisaria todo dia
/// sobre o mesmo contrato até a data chegar, e o gestor aprenderia a ignorar o
/// bot — a única forma de falha realmente cara aqui, porque o aviso continua
/// saindo e ninguém mais lê. Ver DIAS_ENTRE_AVISOS em lib/aviso-gestor.ts.
model AvisoGestor {
  id            String      @id @default(cuid())
  /// O gestor é um Colaborador (quem tem outros apontando para si em
  /// `supervisorId`), não um User: não existe login com papel de gestor.
  gestorId      String
  gestor        Colaborador @relation("AvisosRecebidosComoGestor", fields: [gestorId], references: [id], onDelete: Cascade)
  colaboradorId String
  colaborador   Colaborador @relation("AvisosSobreMim", fields: [colaboradorId], references: [id], onDelete: Cascade)
  /// CONTRATO_VENCENDO | FERIAS_VENCENDO | HORA_EXTRA_ACIMA
  tipo          String
  enviadoEm     DateTime    @default(now())

  @@index([gestorId, colaboradorId, tipo, enviadoEm])
  @@index([enviadoEm])
  @@schema("rh")
}

// ════════════════════════════════════════════════════════════════════════════
// MÓDULO PROCESSOS & ATIVOS — onda 1, parte 1: frota e a Central de Pendências
//
// Base: `estudo-modulo-processos-ativos.md` (23/08/2026), seis frentes de
// pesquisa com cada norma conferida em fonte primária. As decisões do CEO do
// mesmo dia estão na seção 10 de lá.
//
// Por que frota primeiro, entre os cinco domínios: é o único prejuízo CERTO,
// RECORRENTE e CONTÁVEL que o grupo já tem. Multa sem indicar o condutor em 30
// dias custa 3× o valor (CTB, art. 257, §§7º e 8º), toda vez; licenciamento
// vencido é gravíssima com remoção (art. 230, V), e tira a van da rua no meio
// de uma instalação.
//
// Convenções desta seção, iguais às do resto do arquivo: enum é String com os
// valores listados no comentário (o schema roda em Postgres e em SQLite);
// `empresaId` é coluna solta com índice, no padrão de Arquivo/Sinal, e não
// relação — só Colaborador ganha relação de verdade, porque as telas fazem
// `include` a partir dele.
// ════════════════════════════════════════════════════════════════════════════

/// A fila única do módulo: tudo que vence, dos cinco domínios, numa tabela só.
///
/// É a tela que justifica o módulo — as outras guardam, esta cobra. E é
/// materializada, não calculada na leitura, por três motivos que só aparecem
/// depois: as regras compostas mudam (o prazo de comunicação de venda do art.
/// 134 é 30+60, e já foi outro), o calendário de licenciamento é por estado e
/// muda todo ano, e um alerta histórico precisa continuar explicando por que
/// disparou mesmo depois de a regra ter mudado.
///
/// O motor é o MESMO de `Sinal` — cron detecta, atualiza a linha existente pela
/// chave de dedupe, não cria outra. Segundo motor paralelo é como o sistema
/// acaba com duas listas de pendência que discordam entre si.
model Pendencia {
  id String @id @default(cuid())

  // FROTA | CONTRATO | ATIVO | DOCUMENTO | PROCESSO
  dominio String
  // Que regra gerou — para a tela explicar por que isto está aqui.
  // Ex.: INDICAR_CONDUTOR | LICENCIAMENTO | CNH_VENCENDO | CERTIDAO_FORNECEDOR
  tipo    String

  // Ponteiro solto para o registro real (Infracao, Veiculo, Contrato...). Solto
  // e não relação porque a origem tem cinco tipos diferentes — e uma relação
  // por domínio significaria cinco colunas nulas em toda linha.
  origemTipo String
  origemId   String

  empresaId String
  titulo    String
  descricao String?

  // Dono é PESSOA, sempre — nunca "o RH", nunca um setor. Alerta sem dono é
  // ruído que o time aprende a ignorar em um mês.
  //
  // Aponta para User e não para Colaborador (o estudo dizia Colaborador):
  // quem resolve precisa ENTRAR no sistema, e quem entra é User. Mesmo padrão
  // de `Sinal.donoUserId` — soft ref com snapshot do nome, para o histórico
  // não virar "usuário excluído".
  //
  // NULO É PERMITIDO, e a regra do produto continua sendo "sempre tem dono".
  // A coluna nasceu NOT NULL e isso estava errado: com o dono obrigatório no
  // banco, o detector não conseguiria gravar a pendência de um tipo que ainda
  // não tem dono configurado — e o prazo, que é real e está correndo, ficaria
  // INVISÍVEL. Trocar um alerta sem dono por alerta nenhum é o pior dos dois
  // resultados. A regra passa a ser cobrada na TELA, onde pendência sem dono
  // aparece em bloco próprio, no topo, gritando — em vez de sumir em silêncio.
  responsavelId   String?
  responsavelNome String?
  // Quem assume em férias e afastamento. Numa empresa onde uma pessoa acumula
  // RH e compliance, as férias dela não podem congelar quarenta prazos legais.
  substitutoId   String?
  substitutoNome String?

  // A data-alvo, já calculada e indexada. É por ela que a tela ordena.
  venceEm DateTime
  // DIAS_UTEIS | DIAS_CORRIDOS — citação judicial conta em dias úteis,
  // intimação eletrônica conta em corridos. Um motor que só soma dias corridos
  // erra exatamente no prazo mais caro.
  contagem String @default("DIAS_CORRIDOS")
  // INTERNO | JUDICIAL. Prazo JUDICIAL não pode ser sobrestado: o relógio do
  // tribunal corre independentemente do que a empresa decidir.
  origemLegal String @default("INTERNO")

  // CRITICA | ALTA | ATENCAO — DERIVADA de (dias restantes × impacto do
  // domínio), nunca digitada. Digitada, vira opinião de quem cadastrou.
  severidade String

  // ABERTA | EM_ANDAMENTO | RESOLVIDA | DISPENSADA
  estado String @default("ABERTA")
  // Só em DISPENSADA. Sem essa saída um falso positivo fica eterno e o usuário
  // para de confiar na lista inteira — não só naquele item.
  dispensadaMotivo String?
  resolvidaPorId   String?
  resolvidaPorNome String?
  resolvidaEm      DateTime?

  // "Essa pendência já existe?" — a pergunta do cron a cada rodada.
  chaveDedupe String

  detectadaEm  DateTime @default(now())
  confirmadaEm DateTime @default(now())
  atualizadaEm DateTime @updatedAt

  // A query da tela, na ordem em que ela filtra.
  @@index([estado, venceEm, responsavelId, empresaId])
  @@index([chaveDedupe])
  @@index([empresaId, dominio, estado])
  @@schema("rh")
}

/// Com quantos dias de antecedência cada tipo de pendência avisa, e para quem
/// escala quando ninguém trata.
///
/// Por TIPO e não global, e começando conservador: ligar quarenta alertas no
/// primeiro dia é pior que não ter alerta nenhum — alerta vencido e registrado
/// prova que a empresa sabia e não agiu.
model RegraAlerta {
  id   String @id @default(cuid())
  tipo String

  // "20,10,5,2,1" — CSV e não array, porque o schema também roda em SQLite.
  diasAntecedencia String
  escalonaAposDias Int?

  // De quem é a pendência deste tipo, por padrão. É o que o CEO decidiu em
  // 23/08/2026 ao distribuir os domínios por área — frota para operações,
  // contratos para o financeiro — e é o que o detector lê para nomear o dono
  // na hora de criar a linha. Soft ref a User, com snapshot do nome.
  responsavelPadraoUserId String?
  responsavelPadraoNome   String?
  // Para quem sobe quando o prazo aperta e ninguém tratou. Soft ref a User.
  escalonaParaUserId String?
  severidadeBase     String @default("ATENCAO")
  ativa              Boolean @default(true)

  // Nulo = vale para o grupo inteiro. Preenchido = só aquele CNPJ.
  empresaId String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([tipo, empresaId])
  @@schema("rh")
}

/// Feriados, para o motor saber contar dias úteis.
///
/// Inclui FORENSE de propósito: o recesso e os feriados só do tribunal mudam o
/// prazo processual e não aparecem em calendário nenhum de RH.
model Feriado {
  id   String   @id @default(cuid())
  data DateTime
  // NACIONAL | ESTADUAL | MUNICIPAL | FORENSE
  abrangencia String
  uf          String?
  municipio   String?
  tribunal    String?
  descricao   String

  @@index([data, abrangencia])
  @@schema("rh")
}

/// Veículo da frota.
model Veiculo {
  id        String @id @default(cuid())
  empresaId String

  // Só letras e dígitos, sem hífen — a máscara é da tela, igual ao CNPJ da
  // Empresa. Placa Mercosul e placa antiga convivem: transferência de
  // propriedade NÃO obriga a troca (Res. CONTRAN 780/2019, art. 22, §2º), e
  // frota com placa antiga circula até o sucateamento.
  placa         String  @unique
  placaAnterior String?
  renavam       String?
  chassi        String?

  marca     String?
  modelo    String?
  anoFab    Int?
  anoModelo Int?
  categoria String?
  especie   String?
  // Peso bruto total e capacidade máxima de tração, do CRLV. Decidem se o
  // veículo exige cronotacógrafo — vans e carros de instalação ficam abaixo do
  // limite, mas isso se confirma pelo dado real, não por suposição.
  pbt Float?
  cmt Float?

  // Onde está emplacado: decide o CALENDÁRIO de licenciamento e de IPVA, que é
  // estadual. Sem isto o alerta de licenciamento não tem como saber a data.
  ufEmplacamento        String?
  // Mudança de município é gatilho de troca de placa; venda não é.
  municipioEmplacamento String?
  // Cidade-base de operação — de onde o veículo roda. Diferente de
  // `municipioEmplacamento` (onde está emplacado): na frota da L&M muitos não
  // estão emplacados mas têm cidade de operação. Importado da coluna CIDADE.
  cidadeBase            String?
  // Setor/área a que o veículo serve — texto livre de propósito: na planilha
  // vem misturado (TECNICA, INFRA, COMERCIAL, mas também papéis e marcas como
  // CENTRY/VAPT). Vínculo formal com Setor é decisão posterior.
  setor                 String?
  // O veículo está emplacado? Declarado à parte da placa: a planilha traz placa
  // preenchida mesmo em veículo marcado como NÃO emplacado (antiga/provisória).
  emplacado             Boolean @default(false)
  // Motorista informado na planilha — TEXTO, pode trazer dois nomes ("A / B").
  // NÃO substitui o cadastro de Condutor (via AlocacaoVeiculo): é o dado cru
  // para o RH formalizar a alocação depois.
  motoristaInformado    String?
  // Motorista VINCULADO ao cadastro de colaboradores — pedido do RH em
  // 31/08/2026: "com quem está" busca no cadastro, não em texto solto. O texto
  // acima vira legado (exibido só quando este vínculo não existe). SetNull: o
  // colaborador sair não apaga o veículo, só o deixa sem motorista definido.
  motoristaColaboradorId String?
  motoristaColaborador   Colaborador? @relation("MotoristaDoVeiculo", fields: [motoristaColaboradorId], references: [id], onDelete: SetNull)

  // PROPRIO | ALUGADO | COMODATO | LEASING
  propriedade String @default("PROPRIO")

  // COMBUSTAO | ELETRICO | HIBRIDO — decide o que a tela de consumo pede:
  // litros de combustível ou kWh de recarga. Pedido do CEO em 23/08/2026.
  motorizacao String @default("COMBUSTAO")

  // Adesão ao SNE (notificação eletrônica de multa). O desconto de 40% exige
  // que a adesão seja ANTERIOR ao envio da notificação de autuação — por isso
  // a DATA importa, e não só o "sim". Cada semana sem aderir é desconto
  // perdido de forma irreversível.
  aderidoSne    Boolean   @default(false)
  dataAdesaoSne DateTime?

  // Recall pendente impede o licenciamento (CTB, art. 131, §§4º e 5º) — e é a
  // causa de "paguei tudo e não sai o CRLV" que ninguém liga ao recall.
  recallPendente Boolean @default(false)

  // ATIVO | EM_MANUTENCAO | VENDIDO | BAIXADO
  situacao       String    @default("ATIVO")
  dataAquisicao  DateTime?
  dataVenda      DateTime?
  hodometroAtual Int?
  // Valor de referência da tabela FIPE, em reais — informado à mão (pedido do
  // RH em 31/08/2026, para o relatório da frota). Sem integração com a API da
  // FIPE de propósito: o valor gravado é o do mês em que o RH consultou, e
  // atualizar é decisão dele, não de um cron.
  valorFipe      Float?
  observacoes    String?

  criadoPorId   String?
  criadoPorNome String?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  financeiro     VeiculoFinanceiro?
  alocacoes      AlocacaoVeiculo[]
  infracoes      Infracao[]
  documentos     DocumentoVeiculo[]
  transferencias TransferenciaVeiculo[]
  consumos       ConsumoVeiculo[]
  manutencoes    ManutencaoVeiculo[]

  @@index([empresaId, situacao])
  @@index([empresaId, ufEmplacamento])
  @@schema("rh")
}

/// Quem dirige — extensão de Colaborador, não cadastro paralelo.
///
/// Extensão e não entidade nova porque o condutor JÁ existe no sistema: tem
/// admissão, setor, desligamento e ficha. Cadastro paralelo significaria manter
/// dois nomes em dia e descobrir, no dia da multa, que o condutor foi desligado
/// há seis meses e ninguém tirou a chave dele.
model Condutor {
  id            String      @id @default(cuid())
  colaboradorId String      @unique
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  empresaId     String

  cnhNumero    String?
  cnhCategoria String?
  cnhUf        String?
  // LIDA do documento, nunca calculada. A validade da CNH não é uma conta
  // ("10 anos a partir de X"): ela vem impressa, e a regra de anos mudou por
  // faixa etária. Calcular produz alerta na data errada, que é pior que
  // nenhum alerta.
  cnhValidade  DateTime?

  // Exerce atividade remunerada. Muda o limite de pontos e exige curso.
  possuiEAR              Boolean   @default(false)
  toxicologicoUltimaData DateTime?
  toxicologicoValidade   DateTime?

  // Pontos NÃO são derivados da gravidade da infração: o CTB exclui de
  // pontuação sete dispositivos (art. 259, §4º, II) — entre eles o art. 233,
  // que é infração média COM remoção e SEM ponto. Um motor que calcula ponto
  // pela natureza acusa um colaborador injustamente. Daí a coluna guardar o
  // somatório do que de fato pontuou, e a lista de exclusão viver no código.
  pontosAcumulados      Int @default(0)
  limitePontosAplicavel Int @default(20)

  // Zera os pontos antes da suspensão. Quem tem EAR pode fazer aos 30, e há
  // bloqueio de 12 meses entre um curso e outro (art. 261, §§5º a 7º).
  cursoReciclagemUltimaData DateTime?

  // APTO | CNH_VENCIDA | SUSPENSO | AFASTADO
  statusHabilitacao String  @default("APTO")
  // Terceiro que dirige veículo do grupo sem ser colaborador é caso conhecido
  // (motorista de locadora, prestador). Marcado para não entrar em conta de
  // gente da casa.
  condutorExterno   Boolean @default(false)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  alocacoes         AlocacaoVeiculo[]
  infracoesIndicadas Infracao[]
  consumos           ConsumoVeiculo[]

  @@index([empresaId, statusHabilitacao])
  @@index([empresaId, cnhValidade])
  @@schema("rh")
}

/// Quem estava com qual veículo, e em que período.
///
/// É a tabela mais importante do módulo inteiro, e não parece. Ela responde
/// "quem estava com a placa ABC1D23 no dia 14/03 às 15h22?" — que é exatamente
/// o que a Res. CONTRAN 918/2022 (art. 5º, §1º, II) exige para a empresa
/// indicar o condutor SEM a assinatura dele. Com este histórico, indicar
/// condutor deixa de ser trabalho manual de trinta dias e vira uma consulta.
///
/// `dataFim` nula = está com a pessoa agora.
/// Situação de pagamento do veículo — 1:1 com a frota (spec "Financeiro da
/// Frota", 31/08/2026): quitado, financiado, consórcio, leasing ou alugado, e
/// o vencimento da próxima parcela. `qtdParcelasPagas` é CONTADOR simples de
/// propósito: a v2 (tabela de parcelas individualizadas, com comprovante)
/// nasce ao lado sem migrar estado espalhado.
///
/// `dataProximoVencimento` gravada é OVERRIDE MANUAL — vazia, o vencimento é
/// derivado (dataPrimeiraParcela + pagas × recorrência) na leitura, em
/// lib/processos/frota-financeiro.ts. A regra de não avançar sozinho quando a
/// data passa mora lá: vencido fica vencido até alguém registrar a parcela.
model VeiculoFinanceiro {
  id        String  @id @default(cuid())
  empresaId String
  veiculoId String  @unique
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  /// A_VISTA | FINANCIADO | CONSORCIO | LEASING | ALUGADO
  tipoAquisicao String
  /// QUITADO | EM_PAGAMENTO | SUSPENSO
  situacao      String

  credor         String?
  contratoNumero String?
  valorTotal     Float?
  valorParcela   Float?

  qtdParcelasTotal    Int?
  qtdParcelasPagas    Int       @default(0)
  dataPrimeiraParcela DateTime?

  /// MENSAL | QUINZENAL | SEMANAL | BIMESTRAL | TRIMESTRAL | SEMESTRAL |
  /// ANUAL | PERSONALIZADA | SEM_RECORRENCIA
  recorrencia              String @default("MENSAL")
  recorrenciaIntervaloDias Int?

  /// Só o OVERRIDE manual — o vencimento calculado NUNCA é persistido aqui.
  dataProximoVencimento DateTime?

  observacoes String?
  ativo       Boolean @default(true)

  criadoPorId   String?
  criadoPorNome String?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  @@index([empresaId, dataProximoVencimento])
  @@schema("rh")
}

model AlocacaoVeiculo {
  id         String   @id @default(cuid())
  empresaId  String
  veiculoId  String
  veiculo    Veiculo  @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  condutorId String
  condutor   Condutor @relation(fields: [condutorId], references: [id], onDelete: Cascade)

  dataInicio DateTime
  dataFim    DateTime?
  // PERMANENTE | EVENTUAL | POOL
  tipo       String    @default("PERMANENTE")

  // O termo assinado com período de posse — sem ele a indicação de condutor
  // falha e a empresa paga 3×. Aponta para Arquivo, que já é onde os anexos
  // do sistema vivem.
  termoArquivoId String?
  kmEntrega      Int?
  kmDevolucao    Int?
  observacoes    String?

  criadoPorId   String?
  criadoPorNome String?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  // A consulta da indicação de condutor: dado um veículo e uma data, quem era.
  @@index([veiculoId, dataInicio, dataFim])
  @@index([condutorId, dataInicio])
  @@index([empresaId])
  @@schema("rh")
}

/// Multa, com todos os relógios que correm a partir dela.
///
/// Os prazos são colunas MATERIALIZADAS (`prazo*`), e não contas feitas na
/// leitura. Motivo concreto: no SNE o proprietário é considerado notificado 30
/// dias depois da inclusão no sistema (CTB, art. 282-A, §2º) — não na data do
/// e-mail. Guardar a data ficta calculada uma vez, no momento em que se soube
/// dela, é o que faz o alerta histórico continuar explicável depois.
model Infracao {
  id        String  @id @default(cuid())
  empresaId String
  veiculoId String
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  numeroAIT       String
  orgaoAutuador   String?
  // A chave que casa a multa com quem estava dirigindo.
  dataHoraInfracao DateTime
  local            String?

  codigoInfracao String?
  descricao      String?
  // LEVE | MEDIA | GRAVE | GRAVISSIMA
  natureza       String?
  // NÃO derivado da natureza — ver o comentário de Condutor.pontosAcumulados.
  geraPontos     Boolean @default(true)
  pontos         Int     @default(0)

  valorOriginal      Float?
  // Algumas infrações multiplicam o valor base (o exame toxicológico vencido
  // multiplica por 5). Guardar o fator separado do valor mantém as duas coisas
  // auditáveis quando a tabela de valores for reajustada.
  fatorMultiplicador Float @default(1)

  dataExpedicaoNA      DateTime?
  // Data em que a notificação passa a valer, já com a ficção do SNE aplicada.
  dataNotificacaoFicta DateTime?
  prazoIndicacaoCondutor DateTime?
  prazoDefesaAutuacao    DateTime?
  dataExpedicaoNP        DateTime?
  prazoRecursoJARI       DateTime?
  dataVencimentoPagamento DateTime?

  condutorIndicadoId String?
  condutorIndicado   Condutor? @relation(fields: [condutorIndicadoId], references: [id], onDelete: SetNull)
  dataIndicacao      DateTime?
  // ASSINATURA_CONDUTOR | TERMO_RESPONSABILIDADE | NAO_INDICADO
  formaIndicacao     String?
  // PENDENTE | INDICADO | ACEITA | RECUSADA | PERDIDO
  statusIndicacao    String    @default("PENDENTE")

  // AUTUADA | EM_DEFESA | PENALIZADA | RECURSO_JARI | RECURSO_CETRAN |
  // INSTANCIA_ENCERRADA | ARQUIVADA | PAGA | CANCELADA
  //
  // Só INSTANCIA_ENCERRADA libera a trava de licenciamento: a multa só impede
  // licenciar quando o recurso acabou (CTB, art. 284, §3º). Cobrar antes disso
  // é errado, e é o erro que quase todo sistema de frota comete.
  statusProcessual String @default("AUTUADA")

  // 0 | 20 | 40 — o de 40% depende de adesão ao SNE anterior à notificação.
  descontoAplicado Int @default(0)
  // A multa por NÃO ter indicado condutor, que vale o dobro da original.
  // Aponta para a infração que a originou.
  multaNicGerada     Boolean @default(false)
  infracaoOriginalId String?

  arquivoId   String?
  observacoes String?

  criadoPorId   String?
  criadoPorNome String?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  @@unique([numeroAIT, empresaId])
  // "O que vence primeiro?" — a pergunta da Central.
  @@index([empresaId, statusIndicacao, prazoIndicacaoCondutor])
  @@index([empresaId, statusProcessual])
  @@index([veiculoId, dataHoraInfracao])
  @@schema("rh")
}

/// Documento do veículo que tem validade: é daqui que sai metade dos alertas.
///
/// NÃO existe tipo DPVAT nem SPVAT. Os dois foram revogados e não há seguro
/// obrigatório público sendo cobrado — modelar o campo criaria um alerta que
/// nunca resolve, que é o pior tipo de falso positivo: ele desmoraliza a lista
/// inteira. O que substitui é o seguro privado (casco e RCF-V), que tem apólice
/// e vigência de verdade.
model DocumentoVeiculo {
  id        String  @id @default(cuid())
  empresaId String
  veiculoId String
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  // CRLV | LICENCIAMENTO | IPVA | SEGURO_CASCO | SEGURO_RCFV | VISTORIA |
  // CRONOTACOGRAFO | ATPV | NOTA_FISCAL | CONTRATO_LOCACAO | OUTRO
  tipo      String
  exercicio Int?

  dataEmissao    DateTime?
  dataVencimento DateTime?
  valor          Float?
  // O PDF/foto do documento — CRLV-e, licenciamento, apólice, laudo. `@unique`
  // + relação (27/08/2026): a coluna existia solta desde a criação do módulo e
  // nenhuma action escrevia nela. `SetNull` no lugar de `Cascade` pelo mesmo
  // motivo do dossiê do colaborador: apagar o arquivo não pode apagar o
  // registro do documento, que é o que sustenta o alerta de vencimento.
  arquivoId      String?   @unique
  arquivo        Arquivo?  @relation(fields: [arquivoId], references: [id], onDelete: SetNull)
  observacoes    String?

  criadoPorId   String?
  criadoPorNome String?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  @@index([empresaId, dataVencimento])
  @@index([veiculoId, tipo, exercicio])
  @@schema("rh")
}

/// Compra e venda de veículo — dois relógios diferentes correndo ao mesmo tempo.
///
/// Comprando: 30 dias para tirar o novo CRV (CTB, art. 123, §1º).
/// Vendendo: a comunicação de venda tem 60 dias contados do FIM dos 30 do
/// comprador (art. 134) — ou seja, a janela é do 30º ao 90º dia. Não comunicar
/// deixa a empresa SOLIDARIAMENTE responsável por tudo que o comprador fizer
/// com o veículo, e é assim que chega multa de carro vendido há dois anos.
///
/// A assinatura ELETRÔNICA da ATPV-e já vale como comunicação de venda: só a
/// versão impressa gera a tarefa. Por isso a modalidade é campo, não detalhe.
model TransferenciaVeiculo {
  id        String  @id @default(cuid())
  empresaId String
  veiculoId String
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  // COMPRA | VENDA
  tipo                String
  contraparteNome     String?
  contraparteDocumento String?
  municipioContraparte String?
  dataNegocio         DateTime

  // ELETRONICA | IMPRESSA — liga e desliga a tarefa de comunicar a venda.
  modalidadeAtpv String @default("ELETRONICA")

  prazoNovoCrv          DateTime?
  prazoComunicacaoVenda DateTime?
  dataComunicacaoVenda  DateTime?
  comprovanteArquivoId  String?
  observacoes           String?

  criadoPorId   String?
  criadoPorNome String?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  @@index([empresaId, tipo])
  @@index([veiculoId])
  @@schema("rh")
}

/// Abastecimento ou recarga — a linha de despesa recorrente da frota.
///
/// Um registro por evento (não um total mensal digitado): é do evento que
/// saem as contas que importam — km/l entre abastecimentos consecutivos pelo
/// hodômetro, custo por km, consumo por condutor. Um "total do mês" digitado
/// à mão não decompõe em nada e vira número que ninguém confere. O recorte
/// mensal é a TELA que agrega.
///
/// `condutorId` é quem abasteceu/rodou — preenchido por padrão com quem está
/// com o veículo (AlocacaoVeiculo aberta), editável. É o que permite comparar
/// motoristas: mesmo carro, consumos diferentes.
model ConsumoVeiculo {
  id        String  @id @default(cuid())
  empresaId String
  veiculoId String
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  condutorId String?
  condutor   Condutor? @relation(fields: [condutorId], references: [id], onDelete: SetNull)

  data DateTime
  // COMBUSTIVEL | ENERGIA — segue a motorização do veículo, mas fica gravado
  // na linha: um híbrido tem os dois, e o veículo pode mudar de motorização
  // no cadastro sem reescrever o histórico.
  tipo String
  // GASOLINA | ETANOL | DIESEL | GNV | ELETRICIDADE — o que de fato entrou.
  combustivel String?
  // Litros ou kWh, conforme o tipo. O rótulo é da tela.
  quantidade Float
  valorTotal Float
  // Hodômetro NO MOMENTO do abastecimento — é o que permite km/l e R$/km
  // entre dois registros consecutivos. Sem ele o registro vale só como gasto.
  hodometro Int?
  posto     String?
  observacoes String?

  criadoPorId   String?
  criadoPorNome String?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  // A conta de consumo do veículo: registros em ordem cronológica.
  @@index([veiculoId, data])
  @@index([empresaId, data])
  @@index([condutorId, data])
  @@schema("rh")
}

/// Manutenção — a outra metade da despesa, e a origem do alerta de revisão.
model ManutencaoVeiculo {
  id        String  @id @default(cuid())
  empresaId String
  veiculoId String
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  // PREVENTIVA | CORRETIVA | REVISAO | PNEUS | SINISTRO | OUTRA
  tipo      String
  descricao String
  data      DateTime
  valor     Float?
  hodometro Int?
  fornecedor String?

  // Quando preenchidos, viram pendência na Central (o carro avisa a próxima
  // revisão por km OU por data — o que vier primeiro).
  proximaRevisaoData DateTime?
  proximaRevisaoKm   Int?

  arquivoId   String?
  observacoes String?

  criadoPorId   String?
  criadoPorNome String?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  @@index([veiculoId, data])
  @@index([empresaId, data])
  @@index([empresaId, proximaRevisaoData])
  @@schema("rh")
}

// ════════════════════════════════════════════════════════════════════════════
// MÓDULO PROCESSOS & ATIVOS — onda 1, parte 2: contratos e contrapartes
//
// Base: `estudo-modulo-processos-ativos.md` (23/08/2026), seção 6.3 e 6.7.
// Decisão do CEO em 23/08/2026: contratos entram na onda 1 (junto com frota,
// que sobe primeiro e sozinha — a Central precisa nascer com dado real).
//
// Escopo DELIBERADAMENTE menor que o modelo "CLM completo" do estudo: sem
// Aditivo/Garantia/Notificacao/ContratoVersao/ContratoAprovacao/
// ContratoAssinatura como tabelas próprias — isso é o antipadrão nº 5 do
// próprio estudo ("big bang de 5 domínios"), só que dentro de UM domínio.
// `Contrato` também não vira 4 tabelas 1:1 (Vigência/Financeiro/Jurídico
// separados): o resto do módulo (Veiculo, Infracao) já estabeleceu o padrão
// de uma tabela plana por conceito, e a tela não pede a normalização extra.
// Entra o que os 5 alertas de maior dano do estudo exigem; o resto é onda 2.
// ════════════════════════════════════════════════════════════════════════════

/// A empresa ou pessoa do outro lado do contrato — GLOBAL ao grupo, não por
/// CNPJ. O mesmo locador aluga torre para duas empresas do grupo, e o mesmo
/// prestador atende três: cadastrar uma vez só é a regra transversal nº 2 do
/// estudo. Duplicar por CNPJ é como o endereço de notificação formal fica
/// certo numa ficha e desatualizado na outra.
model Contraparte {
  id        String @id @default(cuid())

  // FISICA | JURIDICA
  tipoPessoa String @default("JURIDICA")
  razaoSocial String
  nomeFantasia String?
  // Só dígitos, sem máscara — mesma convenção do CNPJ de Empresa. Único no
  // grupo inteiro: é o que impede cadastrar o mesmo fornecedor duas vezes.
  cnpjCpf   String  @unique
  inscricaoEstadual String?
  endereco  String?
  emailNotificacaoFormal String?
  telefone  String?

  // CSV, não array — mesma convenção de RegraAlerta.diasAntecedencia (o
  // schema roda em SQLite local, sem array nativo). Valores:
  // FORNECEDOR|CLIENTE|LOCADOR|LOCATARIO|PREFEITURA|CONDOMINIO|
  // PRESTADOR_PJ|CONCESSIONARIA|OUTRO
  papeis String

  // NORMAL | ALTA — prestador PJ instalador tende a ALTA: é o maior passivo
  // latente do grupo (responsabilidade subsidiária, Lei 6.019/1974, art. 5º-A,
  // §5º, e STF Tema 725).
  criticidade String @default("NORMAL")

  observacoes String?
  criadoPorId   String?
  criadoPorNome String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contratos Contrato[]

  @@schema("rh")
}

/// O contrato em si — por CNPJ (ao contrário da Contraparte, que é do grupo).
///
/// Os prazos-alvo (`dataLimiteDenuncia`, `janelaRenovatoriaInicio/Fim`,
/// `proximoReajuste`) são colunas MATERIALIZADAS, calculadas ao salvar — regra
/// transversal nº 4: o job diário varre por índice, e um alerta antigo
/// continua explicável mesmo que a regra de cálculo mude depois.
model Contrato {
  id        String @id @default(cuid())
  empresaId String

  // Único por empresa — não global, dois CNPJs podem reaproveitar numeração.
  numero String
  contraparteId String
  contraparte   Contraparte @relation(fields: [contraparteId], references: [id])

  // LOCACAO_TORRE|LOCACAO_TERRENO|COMPARTILHAMENTO_POSTE|
  // PREFEITURA_USO_SOLO|CONDOMINIO|FORNECEDOR|PRESTADOR_PJ|CLIENTE_B2B|OUTRO
  tipo String
  // RECEITA | DESPESA | SEM_VALOR
  categoria String @default("DESPESA")
  titulo String
  objeto String?
  // RASCUNHO|VIGENTE|SUSPENSO|EM_RENOVACAO|ENCERRADO|CANCELADO
  status String @default("VIGENTE")
  // NORMAL | ALTA — puxa a criticidade da contraparte no cadastro, editável.
  criticidade String @default("NORMAL")

  // Soft ref a Colaborador, mesmo padrão de Sinal.donoUserId/donoNome: o
  // histórico não vira "colaborador excluído" se o gestor for desligado —
  // e é exatamente essa desconexão que o detector CONTRATO_SEM_GESTOR cobra.
  gestorId   String?
  gestorNome String?
  setorId    String?

  // ── Vigência ──────────────────────────────────────────────────────────
  dataAssinatura DateTime?
  dataInicio     DateTime
  dataFim        DateTime?
  indeterminado  Boolean @default(false)
  renovacaoAutomatica Boolean @default(false)
  // Em quantos dias antes do fim a denúncia precisa ser comunicada.
  avisoPrevioNaoRenovacaoDias Int?
  // = dataFim − avisoPrevioNaoRenovacaoDias. Nula se indeterminado ou sem
  // aviso prévio configurado.
  dataLimiteDenuncia DateTime?

  // Lei 8.245/1991, art. 51, §5º: só locação NÃO RESIDENCIAL tem ação
  // renovatória, com decadência do direito — não suspende nem interrompe.
  locacaoNaoResidencial Boolean @default(false)
  // = dataFim − 12 meses
  janelaRenovatoriaInicio DateTime?
  // = dataFim − 6 meses — última chamada
  janelaRenovatoriaFim    DateTime?
  // Build to Suit (Lei 8.245, art. 54-A): a renúncia à revisional é
  // FACULDADE contratual, nunca presumida — por isso é campo, não regra fixa.
  buildToSuit Boolean @default(false)
  renunciaRevisionalPactuada Boolean @default(false)

  // ── Financeiro ────────────────────────────────────────────────────────
  valorMensal Float?
  valorTotal  Float?
  // IPCA|IPCA_E|IGPM|IGPDI|INPC|CONTRATUAL|SEM_REAJUSTE
  indiceReajuste String?
  // Validado ≥ 12 na action: Lei 10.192/2001, art. 2º, §1º — cláusula de
  // reajuste com periodicidade menor é NULA de pleno direito, e o §3º
  // alcança artifício de efeito equivalente.
  periodicidadeReajusteMeses Int?
  // 1–12, mês-base do índice.
  mesBaseReajuste Int?
  // Materializada a partir de mesBaseReajuste + periodicidadeReajusteMeses.
  proximoReajuste DateTime?
  /// Quando o reajuste foi APLICADO de verdade — é o que fecha o ciclo.
  ///
  /// Sem esta coluna, `proximoReajuste` era gravado uma vez e nada no sistema
  /// jamais o avançava: passado o mês-base, a pendência ficava vencida PARA
  /// SEMPRE, e a única saída era dispensá-la — o que desligava o alerta de
  /// reajuste daquele contrato em definitivo. Um alerta anual cuja única saída
  /// é o silêncio permanente é pior que alerta nenhum: treina o time a
  /// dispensar.
  ultimoReajusteEm DateTime?
  multaCompensatoriaPct Float?
  multaMoratoriaPct     Float?

  // ── Jurídico ──────────────────────────────────────────────────────────
  foroComarca String?
  foroUf      String?
  lgpdAplicavel Boolean @default(false)

  // ── Específico de telecom: compartilhamento de poste ────────────────────
  // Preço de referência é norma de 2014 (Res. Conjunta ANEEL/ANATEL 4/2014,
  // art. 1º, R$ 3,19/ponto em revisão) — NUNCA hard-coded, por isso não é
  // constante no código: fica só a contagem, o valor é o que está no
  // contrato real.
  pontosFixacaoContratados Int?
  pontosFixacaoOcupados    Int?

  observacoes String?
  arquivoId   String?

  criadoPorId   String?
  criadoPorNome String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recebimentos RecebimentoAluguel[]

  @@unique([empresaId, numero])
  @@index([empresaId, status])
  @@index([empresaId, dataLimiteDenuncia])
  @@index([empresaId, proximoReajuste])
  @@index([contraparteId])
  @@schema("rh")
}

// ════════════════════════════════════════════════════════════════════════════
// CONTROLE DE ACESSO FINO — Onda 1 (24/08/2026)
//
// Fundação, sem efeito na tela ainda. `role` continua sendo a fonte de acesso
// das guardas atuais; estes modelos existem para o modelo novo (perfil +
// permissão por tela) reproduzir o mesmo alcance, provado por
// scripts/test-permissoes.ts. A Onda 2 pluga as guardas e a tela de edição.
//
// O catálogo de permissões e os perfis-semente vivem no CÓDIGO
// (lib/permissoes/catalogo.ts), não no banco: a lista do que existe para
// conceder é derivada do menu e versionada, não um cadastro que apodrece.
// ════════════════════════════════════════════════════════════════════════════

/// Um perfil de acesso — pacote nomeado de permissões que se atribui ao
/// usuário, em vez de marcar dezenas de permissões uma a uma.
///
/// `grants` é CSV (mesma convenção de RegraAlerta/Contraparte — o schema roda
/// em SQLite local, sem array nativo). Cada grant é exato (`rh:folha:editar`)
/// ou curinga (`*`, `rh:*`, `rh:folha:*`) — ver lib/permissoes/catalogo.ts.
///
/// `sistema=true` marca os quatro perfis-semente: a tela da Onda 2 não deixa
/// apagá-los (são a rede de segurança do acesso de todo mundo), mas deixa
/// editá-los e criar outros ao lado.
model Perfil {
  id        String  @id @default(cuid())
  nome      String  @unique
  descricao String?
  grants    String
  sistema   Boolean @default(false)
  ativo     Boolean @default(true)

  usuarios UserPerfil[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("rh")
}

/// Pivô usuário × perfil. Um usuário pode ter mais de um perfil; o acesso
/// efetivo é a UNIÃO dos grants (lib/permissoes/efetivas.ts).
model UserPerfil {
  id       String @id @default(cuid())
  userId   String
  perfilId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  perfil   Perfil @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, perfilId])
  @@index([perfilId])
  @@schema("rh")
}

// ════════════════════════════════════════════════════════════════════════════
// RECEBIMENTO DE ALUGUÉIS — imóveis do grupo alugados a terceiros (25/08/2026)
//
// Pedido do dono do sistema: organizar o que a empresa RECEBE de aluguel.
// Escopo escolhido: "recebi / não recebi por mês" (sem reajuste automático,
// cobrança formal ou cadastro do imóvel como patrimônio — isso é onda 2).
//
// O CONTRATO já existe: um imóvel alugado a terceiro é um `Contrato` com
// `categoria = "RECEITA"` e um tipo de locação. O que faltava é a régua de
// PARCELAS — uma por mês —, que é o que esta tabela traz.
// ════════════════════════════════════════════════════════════════════════════

/// Uma parcela mensal de aluguel A RECEBER, gerada a partir de um Contrato de
/// receita. Uma linha por (contrato, competência) — o `@@unique` abaixo garante
/// que gerar de novo não duplica.
///
/// `recebidoEm` nulo = em aberto. Passada a data de `vencimento` sem receber,
/// vira pendência na Central (mesmo motor dos outros prazos do módulo).
model RecebimentoAluguel {
  id         String  @id @default(cuid())
  contratoId String
  contrato   Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  /// Denormalizado do contrato para as telas escoparem por CNPJ sem um join a
  /// mais — mesmo padrão do resto do módulo. Gravado sempre a partir do
  /// contrato, nunca da URL.
  empresaId String

  /// O mês a que a parcela se refere, no dia 1 UTC (é a chave de competência,
  /// não a data de pagamento). Ex.: março/2026 = 2026-03-01.
  competencia DateTime
  /// Quando aquela parcela vence. É a data que a Central cobra.
  vencimento  DateTime

  /// O quanto era esperado — cópia do valor mensal do contrato NO MOMENTO da
  /// geração. Fica na parcela para um reajuste futuro não reescrever o
  /// histórico do que já venceu. Editável por linha.
  valorPrevisto Float

  /// Preenchidos quando entra o dinheiro. `recebidoEm` nulo = em aberto.
  recebidoEm    DateTime?
  valorRecebido Float?
  observacoes   String?

  registradoPorId   String?
  registradoPorNome String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contratoId, competencia])
  @@index([empresaId, vencimento])
  @@index([empresaId, recebidoEm])
  @@schema("rh")
}

// ════════════════════════════════════════════════════════════════════════════
// MÓDULO DELEGAÇÕES — motor de cobrança de demandas da Direção (28/08/2026)
//
// Terceiro módulo do sistema (ao lado de RH e Processos & Ativos). NÃO é um
// gerenciador de tarefas: é um motor de cobrança e accountability. A unidade é
// a DEMANDA — "o que eu quero que aconteça", dono único, encerrada por quem
// pediu. Subtarefas ("como vai acontecer") são da Fase 2 e NÃO existem aqui.
//
// A ordem de implementação original citava Firestore; a decisão registrada da
// Direção (28/08/2026, PR 1 — mapeamento-convencoes-delegacoes.md no workspace)
// é usar ESTA infraestrutura: Prisma/Postgres, schema `rh`, os arrays da spec
// viram tabelas filhas (repactuacoes[] → DemandaRepactuacao, entregas[] →
// DemandaEntrega).
//
// As 6 regras invioláveis moram no BACKEND (lib/delegacoes/estados.ts valida,
// lib/actions/delegacoes.ts aplica), não na interface:
//   1. Dono único         → `responsavelId` é escalar, nunca array.
//   2. Critério de aceite → NOT NULL aqui + validação de texto não vazio.
//   3. Quem encerra é quem pediu → transição ENCERRAR só pelo solicitante.
//   4. Evidência obrigatória     → ENTREGAR sem evidência é rejeitado.
//   5. Aceite ativo (24/48/72h)  → prazoLimiteAceite() + cron (PR 5).
//   6. Repactuação registrada    → `prazoOriginal` imutável; toda mudança de
//      prazo grava DemandaRepactuacao com motivo.
// ════════════════════════════════════════════════════════════════════════════

/// Uma demanda delegada. Escopo: o módulo NÃO é escopado por CNPJ — a demanda
/// atravessa o grupo; `marcaId` é etiqueta opcional para filtro do painel.
///
/// Quem é quem: `solicitanteId` delegou (e é o ÚNICO que encerra, devolve ou
/// cancela); `responsavelId` executa (e é o único que aceita, repactua e
/// entrega). Ambos são `User` — decisão da Direção em 28/08/2026: pode-se
/// delegar para qualquer login; quem não tem Telegram vinculado
/// (User.colaboradorId → Colaborador.telegramChatId) é cobrado pelos canais
/// restantes, e a tela AVISA (sem bloquear) na criação.
model Demanda {
  id     String  @id @default(cuid())
  /// Máx. 120 caracteres — validado na action (convenção do repo: limite no
  /// backend, não em @db).
  titulo String
  descricao String?

  solicitanteId String
  solicitante   User   @relation("DemandaSolicitante", fields: [solicitanteId], references: [id])

  /// A reunião que gerou esta demanda (uma demanda POR CONVOCADO — a regra 1
  /// do responsável único fica intacta: quem agrupa os convocados é a
  /// Reuniao, nunca a demanda). Null nas demandas comuns. SetNull: apagar a
  /// reunião não pode apagar as cobranças que já correm.
  reuniaoId String?
  reuniao   Reuniao? @relation(fields: [reuniaoId], references: [id], onDelete: SetNull)
  /// UM responsável, sempre. Regra 1: dono único — a coluna é escalar por
  /// desenho, e não existe tabela pivô de responsáveis de propósito.
  responsavelId String
  responsavel   User   @relation("DemandaResponsavel", fields: [responsavelId], references: [id])

  /// "Como sei que ficou pronto." Regra 2: sem isto o registro NÃO é salvo —
  /// a action recusa antes do INSERT, e o NOT NULL segura via API direta.
  criterioAceite String
  /// LINK | ARQUIVO | NUMERO | TEXTO — que forma de evidência a entrega exige.
  evidenciaExigida String
  /// 1 = crítica, 2 = alta, 3 = normal. Decide a régua de cobrança e o limite
  /// de aceite (24/48/72h) — ver lib/delegacoes/estados.ts.
  criticidade Int

  /// Estimativa de ESFORÇO para concluir, em horas — sugerida pela IA ao
  /// redigir (redator.ts), editável antes de enviar. PLANEJAMENTO, não
  /// medição: o sistema não tem apontamento de horas trabalhadas (ver
  /// lib/delegacoes/painel-entregas.ts) — isto é só o que se esperava antes
  /// de começar, comparado depois com o tempo corrido real. Nula quando
  /// ninguém estimou (demanda anterior a este campo, ou preenchida à mão sem
  /// valor).
  horasEstimadas Float?

  /// SEMPRE timestamp, nunca texto livre (spec §3.5). O prazo VIGENTE — muda
  /// por repactuação.
  prazo DateTime
  /// O prazo pactuado na criação. IMUTÁVEL: nenhuma action escreve nesta
  /// coluna depois do INSERT (regra 6) — é ele que denuncia quantas vezes a
  /// demanda escorregou.
  prazoOriginal DateTime

  /// DIARIO | DUAS_POR_SEMANA | SEMANAL | SO_ENTREGA | SO_ATRASO — com que
  /// frequência o solicitante quer retorno no digest.
  periodicidadeRetorno String

  /// Etiqueta de filtro do painel (LM Telecom, Centrysol, VAPT, FASTMAI…).
  /// FK para o cadastro vivo de Marca, não texto livre — decisão da Direção
  /// (28/08/2026) para o filtro não depender de grafia.
  marcaId String?
  marca   Marca?  @relation(fields: [marcaId], references: [id])
  area    String?

  /// RASCUNHO | ENVIADA | ACEITA | EM_EXECUCAO | ENTREGUE | ENCERRADA |
  /// CANCELADA — máquina de estados em lib/delegacoes/estados.ts, com controle
  /// de QUEM pode cada transição. O responsável nunca chega a ENCERRADA.
  status String @default("RASCUNHO")
  /// Flag ORTOGONAL ao status (spec §4): uma demanda ACEITA ou EM_EXECUCAO
  /// pode estar em risco sem mudar de estado.
  emRisco Boolean @default(false)

  /// Quando saiu de RASCUNHO — âncora do limite de aceite (regra 5). Não está
  /// na spec §3.1, mas sem ele o cron de aceite teria que caçar o evento
  /// ENVIADA a cada varredura.
  enviadaEm   DateTime?
  aceiteEm    DateTime?
  encerradaEm DateTime?

  /// Guarda de idempotência das cobranças (spec §6.1): o cron só dispara se a
  /// janela ainda não foi coberta.
  ultimaCobranca  DateTime?
  /// O QUE O CRON CONSULTA (`proximaCobranca <= agora`). Nula até o PR 5
  /// ligar a régua — o modelo nasce pronto para ela.
  proximaCobranca DateTime?
  /// 0–3. Sobe a cada degrau da régua e NUNCA desce sozinho — só zera no
  /// encerramento (spec §6.2).
  nivelEscalonamento Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repactuacoes DemandaRepactuacao[]
  entregas     DemandaEntrega[]
  interacoes   DemandaInteracao[]
  eventos      DemandaEvento[]

  // Índices da spec §3.6, na mesma ordem de consulta.
  @@index([proximaCobranca, status])
  @@index([responsavelId, status])
  @@index([solicitanteId, status])
  @@index([prazo, status])
  @@index([marcaId])
  @@schema("rh")
}

/// Uma repactuação de prazo (spec: `repactuacoes[]`). Repactuar é PERMITIDO e
/// REGISTRADO — nunca sobrescreve `prazoOriginal`, sempre exige motivo.
/// Autor como snapshot (id + nome), padrão AuditLog: o histórico continua
/// legível mesmo se o login sumir.
model DemandaRepactuacao {
  id        String  @id @default(cuid())
  demandaId String
  demanda   Demanda @relation(fields: [demandaId], references: [id], onDelete: Cascade)

  prazoAnterior DateTime
  prazoNovo     DateTime
  motivo        String
  autorId       String?
  autorNome     String?
  createdAt     DateTime @default(now())

  @@index([demandaId, createdAt])
  @@schema("rh")
}

/// Uma tentativa de entrega (spec: `entregas[]`). As DEVOLVIDAS ficam no
/// histórico (`aceita=false` + motivo) — é assim que o painel conta quantas
/// vezes a entrega voltou.
model DemandaEntrega {
  id        String  @id @default(cuid())
  demandaId String
  demanda   Demanda @relation(fields: [demandaId], references: [id], onDelete: Cascade)

  /// Cópia de `evidenciaExigida` NO MOMENTO da entrega — se a exigência mudar
  /// um dia, o histórico não muda junto.
  evidenciaTipo  String
  /// O conteúdo da evidência quando é LINK, NUMERO ou TEXTO.
  evidenciaTexto String?
  /// A evidência quando é ARQUIVO — mesma esteira Arquivo/Blob do dossiê do
  /// colaborador e do documento do veículo. SetNull: apagar o arquivo não
  /// pode apagar o registro de que a entrega aconteceu.
  arquivoId String?  @unique
  arquivo   Arquivo? @relation(fields: [arquivoId], references: [id], onDelete: SetNull)

  /// O que o responsável declarou ao entregar.
  resultado String?
  /// null = aguardando o solicitante; true = aceita (demanda encerrou);
  /// false = devolvida (demanda voltou a EM_EXECUCAO).
  aceita          Boolean?
  motivoDevolucao String?
  avaliadaEm      DateTime?
  createdAt       DateTime @default(now())

  @@index([demandaId, createdAt])
  @@schema("rh")
}

/// Cada cobrança enviada e cada resposta recebida (spec §3.2). É onde a
/// classificação da IA fica gravada com a confiança — auditável por demanda.
model DemandaInteracao {
  id        String  @id @default(cuid())
  demandaId String
  demanda   Demanda @relation(fields: [demandaId], references: [id], onDelete: Cascade)

  /// ENVIADA (o sistema cobrou) | RECEBIDA (o responsável respondeu).
  tipo   String
  /// TELEGRAM | EMAIL | PAINEL
  canal  String
  conteudo String
  /// NO_PRAZO | EM_RISCO | TRAVADO_DEPENDENCIA | PRECISA_DECISAO_SUA —
  /// preenchidos pelo classificador (PR 6) nas interações RECEBIDAS.
  classificacaoIa String?
  confiancaIa     Float?
  createdAt       DateTime @default(now())

  @@index([demandaId, createdAt])
  @@schema("rh")
}

/// Log de auditoria do módulo, IMUTÁVEL (spec §3.3): toda transição,
/// repactuação, escalonamento e entrega gera um evento. Nenhuma action
/// atualiza ou apaga linhas — mesmo contrato do AuditLog. Autor snapshot;
/// eventos do sistema (cron, classificador) saem com autorId nulo e
/// autorNome "sistema".
/// Uma reunião marcada por quem delega (pedido da Direção em 31/08/2026):
/// o agrupador dos convocados. Cada convocado recebe UMA demanda própria
/// (Demanda.reuniaoId) — aceitar a demanda é confirmar presença, e a régua de
/// cobrança que já existe faz o lembrete. A reunião em si não tem máquina de
/// estados: quem tem status são as demandas dela.
model Reuniao {
  id String @id @default(cuid())

  /// Máx. 120 caracteres — validado na action, como o título da demanda.
  titulo String
  pauta  String?
  /// Onde acontece — sala, endereço ou link de vídeo.
  local  String?
  /// QUANDO acontece — timestamp, nunca texto livre (mesma regra do prazo da
  /// demanda). É ele que vira o prazo das demandas dos convocados.
  dataHora DateTime

  solicitanteId String
  solicitante   User   @relation("ReuniaoSolicitante", fields: [solicitanteId], references: [id])

  criadoEm DateTime @default(now())

  demandas Demanda[]

  @@index([solicitanteId, dataHora])
  @@schema("rh")
}

model DemandaEvento {
  id        String  @id @default(cuid())
  demandaId String
  demanda   Demanda @relation(fields: [demandaId], references: [id], onDelete: Cascade)

  /// CRIADA | ENVIADA | ACEITA | EXECUCAO_INICIADA | REPACTUADA | ENTREGUE |
  /// DEVOLVIDA | ENCERRADA | CANCELADA | EM_RISCO_LIGADO | EM_RISCO_DESLIGADO
  /// — e os do motor (PR 5): COBRANCA_ENVIADA | ESCALONADA | ACEITE_COBRADO.
  tipoEvento String
  autorId    String?
  autorNome  String?
  dados      Json?
  createdAt  DateTime @default(now())

  @@index([demandaId, createdAt])
  @@schema("rh")
}

/// Régua de cobrança por criticidade, horários de digest, limites de
/// escalonamento — editável SEM deploy (spec §3.4), mesmo espírito da
/// ConfiguracaoLembrete. Os PADRÕES vivem no código (lib/delegacoes, PR 5);
/// uma linha aqui sobrepõe o padrão daquela chave. Sem seed: tabela vazia =
/// todo mundo no padrão.
model DemandaConfig {
  id        String   @id @default(cuid())
  chave     String   @unique
  valor     Json
  descricao String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("rh")
}

/// Os FAVORITOS de quem delega: as pessoas que aparecem na frente, com um
/// clique, na hora de criar a demanda.
///
/// Pedido da Direção em 29/08/2026, e a razão é o uso real: quem delega
/// dezenas de coisas por dia manda para as MESMAS cinco ou dez pessoas. Uma
/// lista alfabética de todos os usuários faz procurar toda vez; a lista dos
/// diretos resolve em um toque — e é exatamente a turma do piloto.
///
/// É preferência de tela, não permissão: favoritar alguém não concede nada, e
/// quem não é favorito continua alcançável pelo seletor completo.
model DelegacaoFavorito {
  id String @id @default(cuid())

  /// Quem favoritou (a lista é de cada um).
  userId String
  user   User   @relation("FavoritosDeDelegacao", fields: [userId], references: [id], onDelete: Cascade)

  /// A pessoa favoritada.
  favoritoId String
  favorito   User   @relation("FavoritadoParaDelegacao", fields: [favoritoId], references: [id], onDelete: Cascade)

  /// Ordem de exibição — hoje sempre 0 (ordenamos por nome). Existe para o dia
  /// em que a Direção quiser arrastar a lista, sem migration nova.
  ordem     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, favoritoId])
  @@index([userId])
  @@schema("rh")
}
