{
  "name": "sistema-rh",
  "version": "1.97.0",
  "private": true,
  "scripts": {
    "// ━━━━━━━━━━━━━━━━ DESENVOLVIMENTO ━━━━━━━━━━━━━━━━": "",
    "dev": "next dev",
    "type-check": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "prepare": "husky",
    "// ━━━━━━━━━━━━━━━━ BUILD & VALIDAÇÃO ━━━━━━━━━━━━━━━━": "",
    "build": "node validate-env.mjs && node prisma/checar-migracoes.mjs && next build",
    "start": "next start",
    "check:migracoes": "node prisma/checar-migracoes.mjs",
    "// ━━━━━━━━━━━━━━━━ BANCO DE DADOS ━━━━━━━━━━━━━━━━": "",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset",
    "postinstall": "prisma generate",
    "// ━━━━━━━━━━━━━━━━ RELEASE ━━━━━━━━━━━━━━━━": "",
    "release": "node scripts/release.mjs",
    "// ━━━━━━━━━━━━━━━━ DIAGNÓSTICOS ━━━━━━━━━━━━━━━━": "",
    "verificar:deploy": "node --import tsx scripts/motor-verificacao-deploy.ts",
    "diag:envios": "tsx scripts/diag-envios.ts",
    "verificar:assistente": "tsx scripts/verificar-assistente.ts",
    "verificar:dashboard": "tsx scripts/verificar-dashboard.ts",
    "verificar:bi": "tsx scripts/verificar-bi.ts",
    "// ━━━━━━━━━━━━━━━━ BANCO DESCARTÁVEL PARA OS SMOKES ━━━━━━━━━━━━━━━━": "",
    "banco:schema": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script > /tmp/schema-ci.sql && psql \"$DATABASE_URL\" -q -v ON_ERROR_STOP=1 -f /tmp/schema-ci.sql && psql \"$DATABASE_URL\" -q -v ON_ERROR_STOP=1 -f scripts/ci-extras-banco.sql",
    "banco:fixture": "tsx scripts/ci-fixture-banco.ts",
    "banco:preparar": "npm run banco:schema && npm run banco:fixture",
    "smokes": "for s in scripts/smoke-*.ts; do echo \"— $s\"; tsx \"$s\" || exit 1; done",
    "// ━━━━━━━━━━━━━━━━ TESTES FUNCIONAIS ━━━━━━━━━━━━━━━━": "",
    "test:login-tentativas": "tsx scripts/test-login-tentativas.ts",
    "test:ferias": "tsx scripts/test-ferias.ts",
    "test:portal": "tsx scripts/test-portal.ts",
    "test:desacoplamento": "tsx scripts/test-desacoplamento.ts",
    "test:conformidade": "tsx scripts/test-conformidade.ts",
    "test:reconhecimento": "tsx scripts/test-reconhecimento.ts",
    "test:bi": "tsx scripts/test-bi.ts",
    "test:produtividade": "tsx scripts/test-produtividade.ts",
    "test:escala": "tsx scripts/test-escala.ts",
    "test:admissao": "tsx scripts/test-admissao.ts",
    "test:pesquisa-enps-resultado": "tsx scripts/test-pesquisa-enps-resultado.ts",
    "test:entregas": "tsx scripts/test-entregas.ts",
    "// ━━━━━━━━━━━━━━━━ SMOKE TESTS ━━━━━━━━━━━━━━━━": "",
    "smoke:dp": "tsx scripts/smoke-dp.ts",
    "smoke:sst": "tsx scripts/smoke-sst.ts",
    "smoke:movimentacoes": "tsx scripts/smoke-movimentacoes.ts",
    "smoke:beneficios": "tsx scripts/smoke-beneficios.ts",
    "smoke:reconhecimento": "tsx scripts/smoke-reconhecimento.ts",
    "smoke:ciclo": "tsx scripts/smoke-ciclo-pesquisa.ts",
    "smoke:epi": "tsx scripts/smoke-epi.ts",
    "smoke:entregas": "tsx scripts/smoke-entregas.ts",
    "smoke:cat": "tsx scripts/smoke-cat.ts",
    "smoke:escala": "tsx scripts/smoke-escala.ts",
    "smoke:offboarding": "tsx scripts/smoke-offboarding.ts",
    "smoke:pesquisa-vinculo": "tsx scripts/smoke-pesquisa-vinculo.ts",
    "smoke:alertas-rh": "tsx scripts/smoke-alertas-rh.ts",
    "smoke:pesquisa-enps": "tsx scripts/smoke-pesquisa-enps.ts",
    "smoke:pesquisa-onboarding": "tsx scripts/smoke-pesquisa-onboarding.ts",
    "smoke:regua-cobranca": "tsx scripts/smoke-regua-cobranca.ts",
    "smoke:pesquisa-desligamento": "tsx scripts/smoke-pesquisa-desligamento.ts",
    "smoke:avaliacao": "tsx scripts/smoke-avaliacao.ts",
    "smoke:metas": "tsx scripts/smoke-metas.ts",
    "smoke:treinamentos": "tsx scripts/smoke-treinamentos.ts",
    "smoke:ats": "tsx scripts/smoke-ats.ts",
    "smoke:onboarding": "tsx scripts/smoke-onboarding.ts",
    "smoke:folha": "tsx scripts/smoke-folha.ts",
    "smoke:pendencias": "tsx scripts/smoke-pendencias.ts",
    "smoke:cobranca-cadastro": "tsx scripts/smoke-cobranca-cadastro.ts",
    "smoke:login": "tsx scripts/smoke-login.ts",
    "simular:avisos-gestor": "tsx scripts/simular-avisos-gestor.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@sparticuz/chromium": "^149.0.0",
    "@types/nodemailer": "^8.0.1",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "html2pdf": "^0.0.11",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "playwright-core": "^1.61.1",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.81.0",
    "recharts": "^3.10.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "shadcn": "^4.15.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "overrides": {
    "nodemailer": "^9.0.3",
    "sharp": "^0.35.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
